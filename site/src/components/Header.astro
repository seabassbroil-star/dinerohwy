---
import Icon from "./Icon.astro";
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="DineroHWY home">
      <img src="/assets/dinerohwy-logo-primary.svg?v=11" alt="DineroHWY" width="520" height="210" />
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span class="icon-open"><Icon name="menu" size={24} /></span>
      <span class="icon-close"><Icon name="close" size={24} /></span>
    </button>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      <a href="/services/websites">Websites</a>
      <a href="/tools">Software</a>
      <a class="github-link" href="https://github.com/seabassbroil-star" target="_blank" rel="noopener">
        <Icon name="github" size={17} />
        <span>GitHub</span>
      </a>
      <button type="button" class="nav-contact" data-textme-open aria-haspopup="dialog">Contact</button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(6, 27, 20, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 0.68rem;
  }

  .brand img {
    width: clamp(148px, 15vw, 188px);
    height: auto;
    display: block;
    filter: drop-shadow(0 8px 16px rgba(2, 15, 10, 0.24));
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2.3vw, 1.5rem);
    font-size: var(--step--1);
    font-weight: 850;
  }

  .nav-contact {
    border: 0;
    padding: 0;
    background: none;
    color: var(--rust-light);
    font: inherit;
    cursor: pointer;
  }
  .nav-contact:hover {
    color: var(--cream);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.3rem;
    padding-inline: 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(244, 238, 220, 0.04);
  }

  .github-link :global(svg) {
    color: var(--rust-light);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: rgba(244, 238, 220, 0.04);
    color: var(--cream);
    cursor: pointer;
  }

  .nav-toggle .icon-close {
    display: none;
  }

  @media (max-width: 700px) {
    .bar {
      position: relative;
      justify-content: center;
    }

    .nav-toggle {
      display: inline-flex;
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    .nav-toggle[aria-expanded="true"] .icon-open {
      display: none;
    }
    .nav-toggle[aria-expanded="true"] .icon-close {
      display: inline-flex;
    }

    /* dropdown menu — hidden until the toggle is expanded */
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 1.15rem;
      padding: 1.4rem;
      background: rgba(6, 27, 20, 0.98);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      font-size: var(--step-0);
    }

    .nav-toggle[aria-expanded="true"] ~ .nav {
      display: flex;
    }

    .github-link {
      min-height: 2.75rem;
    }
  }
</style>

<script>
  const btn = document.querySelector(".nav-toggle");
  const nav = document.getElementById("primary-nav");
  if (btn && nav) {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
    });
    // close the menu after choosing a destination or opening the contact dialog
    nav.querySelectorAll("a, button").forEach((el) =>
      el.addEventListener("click", () => btn.setAttribute("aria-expanded", "false"))
    );
    // close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") btn.setAttribute("aria-expanded", "false");
    });
  }
</script>
