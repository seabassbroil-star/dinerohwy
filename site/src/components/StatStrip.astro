---
interface Stat { value: string; label: string; }
interface Props { items: Stat[]; }
const { items } = Astro.props;
---

<div class="stats" role="list">
  {items.map((s, i) => (
    <>
      {i > 0 && <span class="stat-sep" aria-hidden="true">·</span>}
      <div class="stat" role="listitem">
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    </>
  ))}
</div>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    font-family: var(--mono);
  }
  .stat { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .stat-value { font-weight: 800; color: var(--cream); font-size: var(--step-0); letter-spacing: -0.02em; }
  .stat-label { color: var(--cream-muted); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; }
  .stat-sep { color: var(--rust); font-weight: 800; }
  @media (max-width: 600px) { .stat-sep { display: none; } .stats { flex-direction: column; } }
</style>
