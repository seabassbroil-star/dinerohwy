---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "./Icon.astro";
import { servicePortfolio, toolsForService } from "../data/portfolio";

interface Props {
  serviceId: string;
  title: string;
  lede: string;
  includes: string[];
  decisions: string[];
  outcome: string;
}

const { serviceId, title, lede, includes, decisions, outcome } = Astro.props;
const service = servicePortfolio.find((entry) => entry.id === serviceId);
if (!service) throw new Error(`Unknown service: ${serviceId}`);
const tools = toolsForService(service);
---

<BaseLayout title={`${service.name} - Dinero Hwy`} description={service.description}>
  <section class="service-hero container">
    <span class="eyebrow">Dinero Hwy service</span>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <div class="hero-actions">
      <button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">Talk through the business <Icon name="arrow-right" size={17} /></button>
      <a class="btn btn-ghost" href="/services">All services</a>
    </div>
  </section>

  <section class="section container split" aria-label={`${service.name} details`}>
    <article class="panel">
      <span class="eyebrow">What the build can include</span>
      <ul>{includes.map((item) => <li><Icon name="check" size={17} /> <span>{item}</span></li>)}</ul>
    </article>
    <article class="panel">
      <span class="eyebrow">What we decide with the owner</span>
      <ul>{decisions.map((item) => <li><Icon name="route" size={17} /> <span>{item}</span></li>)}</ul>
    </article>
  </section>

  <section class="section container tools-used">
    <div class="section-head"><span class="eyebrow">The Dinero Hwy system behind it</span><h2>Tools supporting this service</h2></div>
    <div class="tool-row">
      {tools.map((tool) => (
        <article><Icon name={tool.icon} size={22} /><div><b>{tool.name}</b><span>{tool.status}</span><p>{tool.value}</p></div></article>
      ))}
    </div>
  </section>

  <section class="section container outcome">
    <span class="eyebrow">The point</span><h2>{outcome}</h2>
    <p>You know the business. Dinero Hwy handles the internet part, explains the tradeoffs, and remains accountable for what gets built.</p>
    <button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">Start the conversation <Icon name="arrow-right" size={17} /></button>
  </section>
</BaseLayout>

<style>
  .service-hero { padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg); }
  .service-hero h1 { max-width: 900px; margin-top: 0.45rem; letter-spacing: 0; }
  .service-hero .lede { max-width: 760px; color: var(--cream-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-md); }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); padding-top: 0; }
  .panel { padding: clamp(1.2rem, 3vw, 1.8rem); border: 1px solid var(--line); border-radius: 18px; background: rgba(6, 27, 20, 0.58); }
  .panel ul { display: grid; gap: 0.85rem; margin: 1.1rem 0 0; padding: 0; list-style: none; }
  .panel li { display: flex; gap: 0.65rem; align-items: flex-start; color: var(--cream-muted); }
  .panel li :global(svg) { flex: 0 0 auto; margin-top: 0.24rem; color: var(--rust-light); }
  .tools-used { padding-top: var(--space-md); }
  .section-head { margin-bottom: var(--space-md); }
  .section-head h2 { margin-top: 0.35rem; letter-spacing: 0; }
  .tool-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-md); }
  .tool-row article { display: flex; gap: 0.8rem; padding: 1.1rem; border: 1px solid var(--line); border-radius: 16px; background: rgba(6, 27, 20, 0.48); }
  .tool-row article > :global(svg) { flex: 0 0 auto; color: var(--rust-light); }
  .tool-row b, .tool-row span { display: block; }
  .tool-row span { color: var(--rust-light); font: 800 0.68rem/1.5 var(--mono); text-transform: uppercase; }
  .tool-row p { margin: 0.35rem 0 0; color: var(--cream-muted); }
  .outcome { max-width: 860px; text-align: center; padding-top: var(--space-md); }
  .outcome h2 { margin-top: 0.35rem; letter-spacing: 0; }
  .outcome p { max-width: 660px; margin-inline: auto; color: var(--cream-muted); }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } }
</style>
