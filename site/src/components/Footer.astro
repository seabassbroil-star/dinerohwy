---
import Icon from "./Icon.astro";

const year = 2026;
---

<footer class="site-footer">
  <div class="container footer-row">
    <span>© {year} DineroHWY</span>
    <span>Galveston, Texas</span>
    <a href="/showcase">Showcase</a>
    <a href="https://github.com/seabassbroil-star" target="_blank" rel="noopener" aria-label="seabassbroil-star on GitHub">
      <Icon name="github" size={16} />
      <span>GitHub</span>
    </a>
    <a href="https://x.com/dinerohwy" target="_blank" rel="noopener" aria-label="DineroHWY on X">
      <Icon name="x" size={16} />
      <span>@dinerohwy</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: rgba(6, 27, 20, 0.82);
  }

  .footer-row {
    min-height: 3.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.85rem, 3vw, 2rem);
    color: var(--cream-muted);
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-row a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--cream);
  }

  .footer-row a:hover {
    color: var(--rust-light);
  }

  .footer-row :global(svg) {
    color: var(--rust-light);
  }

  @media (max-width: 700px) {
    .footer-row {
      min-height: 2.7rem;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0.35rem;
      padding-block: 0.45rem;
      font-size: 0.56rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
  }
</style>
