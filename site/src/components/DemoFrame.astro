---
import { getLangFromUrl, useT } from "../i18n/ui";
import Icon from "./Icon.astro";
import EmailCapture from "./EmailCapture.astro";

interface Props {
  title: string;
  status?: "live" | "coming-soon";
  caption?: string;
  waitlistMagnet?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const { title, status = "live", caption, waitlistMagnet = "waitlist" } = Astro.props;
const isLive = status === "live";
---

<figure class="demo-frame" data-status={status}>
  <div class="demo-chrome">
    <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="demo-title">{title}</span>
    <span class:list={["demo-badge", isLive ? "is-live" : "is-soon"]}>
      {isLive ? t("demo.live") : t("demo.coming")}
    </span>
  </div>

  <div class="demo-stage">
    {isLive ? (
      <slot />
    ) : (
      <div class="demo-soon">
        <div class="demo-soon-slot"><slot /></div>
        <div class="demo-soon-overlay">
          <Icon name="waypoint" size={28} />
          <p>{caption ?? "This tool is on the way — get on the waitlist and we'll show you first."}</p>
          <EmailCapture variant="demo" magnet={waitlistMagnet} source={`waitlist:${title}`} heading="" sub="" buttonLabel="Join the waitlist" />
        </div>
      </div>
    )}
  </div>

  {caption && isLive && <figcaption class="demo-caption">{caption}</figcaption>}
</figure>

<style>
  .demo-frame {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--forest-900);
    box-shadow: var(--shadow-md);
  }
  .demo-chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--forest-800);
    border-bottom: 1px solid var(--line);
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .demo-title { font-size: var(--step--1); font-weight: 800; color: var(--cream-muted); }
  .demo-badge {
    margin-left: auto;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
  }
  .is-live { color: var(--cream); background: linear-gradient(145deg, var(--rust-light), var(--rust-deep)); }
  .is-soon { color: var(--cream-muted); border: 1px solid var(--line-strong); }

  .demo-stage { padding: clamp(1rem, 3vw, 2rem); }

  .demo-soon { position: relative; }
  .demo-soon-slot { opacity: 0.28; filter: blur(2px); pointer-events: none; user-select: none; }
  .demo-soon-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1rem;
  }
  .demo-soon-overlay :global(svg) { color: var(--rust-light); }
  .demo-soon-overlay p { color: var(--cream); max-width: 34ch; margin: 0; }

  .demo-caption {
    padding: 0.75rem 1rem 1rem;
    color: var(--cream-muted);
    font-size: var(--step--1);
  }
</style>
