---
// The AI-leverage credibility strip. Plain-text model names only — no
// third-party logos, no implied endorsement (see docs/messaging.md).
interface Props {
  label?: string;
  size?: "sm" | "md";
}
const { label = "Powered by", size = "md" } = Astro.props;
const models = ["Claude", "ChatGPT", "Grok"];
---

<span class:list={["aistack", `aistack--${size}`]}>
  {label && <span class="aistack-label">{label}</span>}
  {models.map((m, i) => (
    <>
      {i > 0 && <span class="aistack-sep" aria-hidden="true">·</span>}
      <span class="aistack-chip">{m}</span>
    </>
  ))}
</span>

<style>
  .aistack {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45em;
    font-family: var(--mono);
    letter-spacing: 0.02em;
  }
  .aistack-label {
    color: var(--cream-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78em;
    font-weight: 700;
  }
  .aistack-chip {
    padding: 0.22em 0.6em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(6, 27, 20, 0.5);
    color: var(--cream);
    font-weight: 700;
  }
  .aistack-sep { color: var(--rust); font-weight: 800; }
  .aistack--md { font-size: var(--step--1); }
  .aistack--sm { font-size: 0.72rem; }
</style>
