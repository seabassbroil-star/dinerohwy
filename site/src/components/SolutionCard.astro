---
import Icon from "./Icon.astro";
import type { IconName } from "../icons";

interface Props {
  href: string;
  icon: IconName;
  title: string;
  blurb: string;
  status?: "live" | "coming-soon";
}
const { href, icon, title, blurb, status = "live" } = Astro.props;
---

<a class="solution" href={href}>
  <span class="solution-icon"><Icon name={icon} size={26} /></span>
  <span class="solution-body">
    <span class="solution-head">
      <span class="solution-title">{title}</span>
      {status === "coming-soon" && <span class="solution-tag">Soon</span>}
    </span>
    <span class="solution-blurb">{blurb}</span>
  </span>
  <span class="solution-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
</a>

<style>
  .solution {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(40, 84, 64, 0.22), rgba(6, 27, 20, 0.28));
    transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
  }
  .solution:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    color: var(--cream);
    background: linear-gradient(160deg, rgba(40, 84, 64, 0.34), rgba(6, 27, 20, 0.3));
  }
  .solution-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(6, 27, 20, 0.5);
    border: 1px solid var(--line);
    color: var(--rust-light);
  }
  .solution-head { display: flex; align-items: center; gap: 0.6rem; }
  .solution-title { font-weight: 800; font-size: var(--step-1); letter-spacing: -0.02em; }
  .solution-tag {
    font-size: 10px; font-weight: 850; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cream-muted); border: 1px solid var(--line-strong);
    padding: 0.15rem 0.4rem; border-radius: 999px;
  }
  .solution-blurb { display: block; margin-top: 0.3rem; color: var(--cream-muted); font-size: var(--step-0); }
  .solution-arrow { color: var(--cream-muted); }
  .solution:hover .solution-arrow { color: var(--rust-light); }
</style>
