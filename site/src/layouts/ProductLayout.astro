---
import BaseLayout from "./BaseLayout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../icons";

interface Props {
  title: string;
  eyebrow?: string;
  tagline: string;
  icon?: IconName;
  metaTitle?: string;
  description?: string;
  magnet?: string;
}

const { title, eyebrow, tagline, icon, metaTitle, description, magnet = "report-card" } = Astro.props;
---

<BaseLayout title={metaTitle ?? `${title} — Dinero Hwy`} description={description ?? tagline}>
  <section class="product-hero section container">
    {icon && <span class="product-icon"><Icon name={icon} size={30} /></span>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    <p class="lede">{tagline}</p>
    <div class="route-bar" aria-hidden="true"></div>
  </section>

  <div class="container product-body">
    <slot />
  </div>

  <section class="section container product-cta">
    <div class="card">
      <h2>See it working on your own business.</h2>
      <p class="lede">Get the free Report Card and we'll show you exactly where this tool fits.</p>
      <EmailCapture variant="inline" magnet={magnet} source={`product:${title}`} heading="" sub="" collectBusiness={true} />
    </div>
  </section>
</BaseLayout>

<style>
  .product-hero { display: grid; justify-items: start; gap: 0.75rem; max-width: 780px; padding-top: var(--space-2xl); }
  .product-icon {
    display: grid; place-items: center; width: 54px; height: 54px;
    border-radius: var(--radius-md); background: rgba(6, 27, 20, 0.5);
    border: 1px solid var(--line); color: var(--rust-light);
  }
  .product-body { display: grid; gap: var(--space-xl); }
  .product-cta .card { text-align: center; display: grid; gap: 0.5rem; justify-items: center; }
  .product-cta :global(.capture-row) { justify-content: center; }
</style>
