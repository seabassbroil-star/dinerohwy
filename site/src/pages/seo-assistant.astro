---
import ProductLayout from "../layouts/ProductLayout.astro";
import DemoFrame from "../components/DemoFrame.astro";
---

<ProductLayout
  title="SEO Assistant"
  eyebrow="Rank where it's easy first"
  icon="seo"
  tagline="Find the easiest thing your business can rank for, ship a page for it, and watch the real search data pick your next move — instead of guessing."
  description="A version-aware SEO assistant that ships pages and measures what actually moved."
  magnet="seo-waitlist"
>
  <section>
    <h2>What makes it different</h2>
    <p class="lede">Not another one-time score checker. It watches what changed between two versions of your site and explains what improved and what broke — then ties it to real impressions and clicks.</p>
    <DemoFrame title="Audit diff" status="coming-soon" caption="First live test subject: a daily Galveston beach-conditions page. The crawl-diff demo lands here.">
      <div style="min-height:240px"></div>
    </DemoFrame>
  </section>
</ProductLayout>
