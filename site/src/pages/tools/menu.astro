---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
---

<BaseLayout title="Menu & Checkout Builder - Dinero Hwy" description="Upload a menu and turn it into a temporary, editable cart preview. No real orders, payments, or saved menus.">
  <section class="menu-hero container">
    <div><span class="eyebrow">Dinero Hwy · Secure preview</span><h1>Turn your menu into a cart—without taking a real order.</h1><p class="lede">Upload an image, a PDF of five pages or fewer, or a CSV. Review every extracted item and price, then see how your menu could work as a checkout cart.</p></div>
    <aside class="safety"><Icon name="check" size={24} /><div><b>Built to forget</b><p>The original file is sanitized in your browser. The temporary draft clears after 15 minutes of inactivity, 30 minutes total, or any refresh.</p></div></aside>
  </section>

  <section class="section container builder-shell" aria-labelledby="upload-title">
    <form id="menu-upload" class="upload-card">
      <div class="visually-hidden" aria-hidden="true"><label>Company website<input name="company" tabindex="-1" autocomplete="off" /></label></div>
      <div class="upload-head"><Icon name="upload" size={28} /><div><h2 id="upload-title">Upload a menu</h2><p>JPEG, PNG, WebP, PDF (up to 5 pages), or CSV · 5 MB maximum</p></div></div>
      <label class="file-drop"><input id="menu-file" name="menu-source" type="file" accept="image/jpeg,image/png,image/webp,application/pdf,text/csv,.csv" required /><span>Choose a menu file</span><small data-file-name>No file selected</small></label>
      <label class="consent"><input name="consent" type="checkbox" required /><span>I understand sanitized menu content is temporarily processed to create this preview and is not saved by Dinero Hwy.</span></label>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEawGmmRMkt49lED" data-theme="dark" data-action="menu_import"></div>
      <button class="btn btn-primary" type="submit">Build my cart preview <Icon name="arrow-right" size={17} /></button>
      <p class="form-status" data-status role="status" aria-live="polite"></p>
    </form>

    <aside class="boundary-card">
      <span class="eyebrow">What this preview cannot do</span>
      <ul><li><Icon name="close" size={16} /> Accept payment</li><li><Icon name="close" size={16} /> Place or transmit an order</li><li><Icon name="close" size={16} /> Save a menu or cart</li><li><Icon name="close" size={16} /> Change a live business menu</li></ul>
      <p>A production ordering system is configured separately around hours, inventory, payment timing, fulfillment, owner permissions, and fallback procedures.</p>
      <a href="/services/ordering">See production ordering <Icon name="arrow-right" size={15} /></a>
    </aside>
  </section>

  <section class="section container draft" data-draft hidden aria-labelledby="draft-title">
    <div class="draft-head"><div><span class="eyebrow">Review before previewing</span><h2 id="draft-title">Correct every item and price.</h2><p data-expiry>Nothing is saved. This draft will clear automatically.</p></div><button class="btn btn-ghost" type="button" data-clear>Clear now</button></div>
    <div class="warnings" data-warnings hidden></div>
    <label class="business-name"><span>Business name</span><input class="field" data-business maxlength="100" /></label>
    <div class="items" data-items></div>
    <div class="draft-actions"><button class="btn btn-ghost" type="button" data-add-item>Add an item</button><button class="btn btn-primary" type="button" data-build-cart>Build cart preview <Icon name="arrow-right" size={16} /></button></div>
  </section>

  <section class="section container cart" data-cart hidden aria-labelledby="cart-title">
    <div class="cart-head"><span class="eyebrow">Browse-only checkout</span><h2 id="cart-title" data-cart-title>Your menu preview</h2><p>Add items and test quantities. The final button is deliberately disabled.</p></div>
    <div class="catalog" data-catalog></div>
    <aside class="cart-summary"><div><span data-cart-count>0 items</span><strong data-cart-total>$0.00</strong></div><button type="button" disabled>Preview only · no checkout</button></aside>
    <div class="cart-cta"><p>Ready to turn this into a real business workflow? Your menu is not attached to this request.</p><button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">Build this for my business <Icon name="arrow-right" size={16} /></button></div>
  </section>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>

<script>
  type Confidence = "high" | "medium" | "low";
  type Item = { id: string; category: string; name: string; description: string; priceCents: number | null; confidence: Confidence };
  type Draft = { businessName: string; currency: "USD"; items: Item[]; warnings: string[]; expiresAt: string };
  const form = document.querySelector<HTMLFormElement>("#menu-upload");
  const fileInput = document.querySelector<HTMLInputElement>("#menu-file");
  const status = document.querySelector<HTMLElement>("[data-status]");
  const draftShell = document.querySelector<HTMLElement>("[data-draft]");
  const cartShell = document.querySelector<HTMLElement>("[data-cart]");
  const itemsRoot = document.querySelector<HTMLElement>("[data-items]");
  const warningsRoot = document.querySelector<HTMLElement>("[data-warnings]");
  const businessInput = document.querySelector<HTMLInputElement>("[data-business]");
  let draft: Draft | null = null;
  let inactivityTimer = 0;
  let hardTimer = 0;
  let lastActivity = 0;

  const money = (cents: number | null) => cents === null ? "" : (cents / 100).toFixed(2);
  const clean = (value: string, max: number) => value.replace(/[<>\u0000-\u001f\u007f]/g, " ").replace(/^\s*[=+@-]/, "").replace(/\s+/g, " ").trim().slice(0, max);
  const setStatus = (message: string, error = false) => { if (status) { status.textContent = message; status.classList.toggle("error", error); } };
  const resetTurnstile = () => (window as Window & { turnstile?: { reset?: () => void } }).turnstile?.reset?.();

  fileInput?.addEventListener("change", () => {
    const label = document.querySelector<HTMLElement>("[data-file-name]");
    if (label) label.textContent = fileInput.files?.[0]?.name || "No file selected";
  });

  function canvasBlob(canvas: HTMLCanvasElement, type = "image/jpeg", quality = 0.86): Promise<Blob> {
    return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error("Could not sanitize this image.")), type, quality));
  }

  async function sanitizeImage(file: File): Promise<Blob> {
    const bitmap = await createImageBitmap(file);
    if (bitmap.width * bitmap.height > 25_000_000) throw new Error("That image has too many pixels. Use a smaller export.");
    const maxWidth = 1800, maxHeight = 4500, maxPixels = 8_000_000;
    const scale = Math.min(1, maxWidth / bitmap.width, maxHeight / bitmap.height, Math.sqrt(maxPixels / (bitmap.width * bitmap.height)));
    const canvas = document.createElement("canvas");
    canvas.width = Math.max(1, Math.round(bitmap.width * scale)); canvas.height = Math.max(1, Math.round(bitmap.height * scale));
    const context = canvas.getContext("2d"); if (!context) throw new Error("Image processing is unavailable in this browser.");
    context.fillStyle = "#fff"; context.fillRect(0, 0, canvas.width, canvas.height); context.drawImage(bitmap, 0, 0, canvas.width, canvas.height); bitmap.close();
    return canvasBlob(canvas);
  }

  async function sanitizePdf(file: File): Promise<Blob> {
    const [{ GlobalWorkerOptions, getDocument }, { default: pdfWorkerUrl }] = await Promise.all([
      import("pdfjs-dist"),
      import("pdfjs-dist/build/pdf.worker.min.mjs?url"),
    ]);
    GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
    const loading = getDocument({ data: new Uint8Array(await file.arrayBuffer()), isEvalSupported: false, useSystemFonts: true });
    const pdf = await loading.promise;
    if (pdf.numPages > 5) throw new Error("Use a PDF with five pages or fewer.");
    const rendered: HTMLCanvasElement[] = [];
    for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
      const page = await pdf.getPage(pageNumber); const base = page.getViewport({ scale: 1 }); const scale = Math.min(2, 820 / base.width); const viewport = page.getViewport({ scale });
      const canvas = document.createElement("canvas"); canvas.width = Math.ceil(viewport.width); canvas.height = Math.ceil(viewport.height);
      const context = canvas.getContext("2d"); if (!context) throw new Error("PDF processing is unavailable in this browser.");
      context.fillStyle = "#fff"; context.fillRect(0, 0, canvas.width, canvas.height); await page.render({ canvasContext: context, viewport, canvas }).promise; rendered.push(canvas);
    }
    const gap = 20, label = 32, columns = rendered.length > 1 ? 2 : 1; const cellWidth = Math.max(...rendered.map((page) => page.width));
    const rows = Math.ceil(rendered.length / columns); const rowHeights = Array.from({ length: rows }, (_, row) => Math.max(...rendered.slice(row * columns, row * columns + columns).map((page) => page.height + label)));
    const sheet = document.createElement("canvas"); sheet.width = cellWidth * columns + gap * (columns + 1); sheet.height = rowHeights.reduce((sum, height) => sum + height, gap * (rows + 1));
    const context = sheet.getContext("2d"); if (!context) throw new Error("PDF processing is unavailable in this browser."); context.fillStyle = "#fff"; context.fillRect(0, 0, sheet.width, sheet.height); context.fillStyle = "#0b2d22"; context.font = "700 18px sans-serif";
    rendered.forEach((page, index) => { const row = Math.floor(index / columns), column = index % columns, x = gap + column * (cellWidth + gap), y = gap + rowHeights.slice(0, row).reduce((sum, height) => sum + height + gap, 0); context.fillText(`Page ${index + 1}`, x, y + 20); context.drawImage(page, x, y + label); });
    await pdf.destroy(); return canvasBlob(sheet, "image/jpeg", 0.82);
  }

  function parseCsv(text: string): Draft {
    const rows: string[][] = []; let row: string[] = [], cell = "", quoted = false;
    for (let index = 0; index < text.length; index += 1) { const char = text[index]; if (char === '"' && quoted && text[index + 1] === '"') { cell += '"'; index += 1; } else if (char === '"') quoted = !quoted; else if (char === "," && !quoted) { row.push(cell); cell = ""; } else if ((char === "\n" || char === "\r") && !quoted) { if (char === "\r" && text[index + 1] === "\n") index += 1; row.push(cell); if (row.some((part) => part.trim())) rows.push(row); row = []; cell = ""; } else cell += char; }
    row.push(cell); if (row.some((part) => part.trim())) rows.push(row); if (rows.length < 2) throw new Error("CSV needs a header row and at least one item.");
    const headers = rows[0].map((value) => clean(value.toLowerCase(), 40)); const column = (...names: string[]) => headers.findIndex((header) => names.includes(header));
    const nameCol = column("name", "item", "product"), priceCol = column("price", "cost"), categoryCol = column("category", "section"), descriptionCol = column("description", "details");
    if (nameCol < 0) throw new Error("CSV needs a name, item, or product column.");
    const items = rows.slice(1, 81).flatMap((values, index): Item[] => { const name = clean(values[nameCol] || "", 100); if (!name) return []; const priceText = (values[priceCol] || "").replace(/[^0-9.-]/g, ""); const price = priceText && Number.isFinite(Number(priceText)) ? Math.max(0, Math.round(Number(priceText) * 100)) : null; return [{ id: `item-${index + 1}`, category: clean(values[categoryCol] || "Menu", 60) || "Menu", name, description: clean(values[descriptionCol] || "", 240), priceCents: price, confidence: price === null ? "low" : "high" }]; });
    return { businessName: clean(fileInput?.files?.[0]?.name.replace(/\.[^.]+$/, "") || "My business", 100), currency: "USD", items, warnings: items.some((item) => item.priceCents === null) ? ["Review items with missing prices."] : [], expiresAt: new Date(Date.now() + 30 * 60_000).toISOString() };
  }

  function touchDraft() { if (!draft) return; lastActivity = Date.now(); window.clearTimeout(inactivityTimer); inactivityTimer = window.setTimeout(() => clearDraft("The temporary draft expired after 15 minutes of inactivity."), 15 * 60_000); }
  function clearDraft(message = "The temporary menu was cleared.") { draft = null; window.clearTimeout(inactivityTimer); window.clearTimeout(hardTimer); if (draftShell) draftShell.hidden = true; if (cartShell) cartShell.hidden = true; if (itemsRoot) itemsRoot.replaceChildren(); setStatus(message); form?.reset(); const name = document.querySelector<HTMLElement>("[data-file-name]"); if (name) name.textContent = "No file selected"; }

  function makeInput(value: string, max: number, label: string) { const input = document.createElement("input"); input.value = value; input.maxLength = max; input.setAttribute("aria-label", label); return input; }
  function renderDraft(next: Draft) {
    draft = next; lastActivity = Date.now(); window.clearTimeout(hardTimer); hardTimer = window.setTimeout(() => clearDraft("The 30-minute preview expired and was cleared."), 30 * 60_000); touchDraft();
    if (businessInput) businessInput.value = next.businessName; if (itemsRoot) itemsRoot.replaceChildren();
    if (warningsRoot) { warningsRoot.replaceChildren(...next.warnings.map((warning) => { const p = document.createElement("p"); p.textContent = warning; return p; })); warningsRoot.hidden = next.warnings.length === 0; }
    next.items.forEach((item) => addEditor(item)); if (draftShell) { draftShell.hidden = false; draftShell.scrollIntoView({ behavior: "smooth", block: "start" }); }
    setStatus("Menu extracted. Review every item and price before building the cart preview.");
  }

  function addEditor(item: Item) {
    if (!itemsRoot) return; const card = document.createElement("article"); card.className = "item-editor"; card.dataset.id = item.id;
    const confidence = document.createElement("span"); confidence.className = `confidence ${item.confidence}`; confidence.textContent = `${item.confidence} confidence`;
    const category = makeInput(item.category, 60, "Category"); category.dataset.field = "category"; const name = makeInput(item.name, 100, "Item name"); name.dataset.field = "name"; const description = makeInput(item.description, 240, "Description"); description.dataset.field = "description"; const price = makeInput(money(item.priceCents), 12, "Price in dollars"); price.dataset.field = "price"; price.inputMode = "decimal"; const remove = document.createElement("button"); remove.type = "button"; remove.textContent = "Remove"; remove.addEventListener("click", () => { card.remove(); touchDraft(); });
    const fields = [["Category", category], ["Item", name], ["Description", description], ["Price ($)", price]] as const; const grid = document.createElement("div"); grid.className = "editor-grid"; fields.forEach(([text, input]) => { const label = document.createElement("label"); const span = document.createElement("span"); span.textContent = text; label.append(span, input); grid.append(label); }); card.append(confidence, grid, remove); card.addEventListener("input", touchDraft); itemsRoot.append(card);
  }

  function collectDraft(): Draft | null { if (!draft || !itemsRoot) return null; const items = [...itemsRoot.querySelectorAll<HTMLElement>(".item-editor")].flatMap((card, index): Item[] => { const get = (field: string) => clean(card.querySelector<HTMLInputElement>(`[data-field="${field}"]`)?.value || "", field === "description" ? 240 : 100); const name = get("name"); if (!name) return []; const raw = card.querySelector<HTMLInputElement>('[data-field="price"]')?.value.replace(/[^0-9.]/g, "") || ""; return [{ id: `item-${index + 1}`, category: get("category") || "Menu", name, description: get("description"), priceCents: raw && Number.isFinite(Number(raw)) ? Math.round(Number(raw) * 100) : null, confidence: "high" }]; }); if (!items.length) { setStatus("Add at least one menu item.", true); return null; } return { ...draft, businessName: clean(businessInput?.value || "My business", 100) || "My business", items }; }

  function renderCart() { const current = collectDraft(); if (!current) return; draft = current; const root = document.querySelector<HTMLElement>("[data-catalog]"); if (!root) return; root.replaceChildren(); const cart = new Map<string, number>(); const update = () => { let count = 0, total = 0; current.items.forEach((item) => { const quantity = cart.get(item.id) || 0; count += quantity; total += quantity * (item.priceCents || 0); }); const countEl = document.querySelector<HTMLElement>("[data-cart-count]"); const totalEl = document.querySelector<HTMLElement>("[data-cart-total]"); if (countEl) countEl.textContent = `${count} ${count === 1 ? "item" : "items"}`; if (totalEl) totalEl.textContent = `$${(total / 100).toFixed(2)}`; touchDraft(); };
    const title = document.querySelector<HTMLElement>("[data-cart-title]"); if (title) title.textContent = `${current.businessName} cart preview`; current.items.forEach((item) => { const card = document.createElement("article"); const category = document.createElement("span"); category.textContent = item.category; const heading = document.createElement("h3"); heading.textContent = item.name; const description = document.createElement("p"); description.textContent = item.description; const price = document.createElement("strong"); price.textContent = item.priceCents === null ? "Price needs review" : `$${money(item.priceCents)}`; const add = document.createElement("button"); add.type = "button"; add.textContent = "Add"; add.disabled = item.priceCents === null; add.addEventListener("click", () => { cart.set(item.id, (cart.get(item.id) || 0) + 1); update(); }); card.append(category, heading, description, price, add); root.append(card); }); update(); if (cartShell) { cartShell.hidden = false; cartShell.scrollIntoView({ behavior: "smooth", block: "start" }); } }

  form?.addEventListener("submit", async (event) => { event.preventDefault(); const file = fileInput?.files?.[0]; if (!file || !form.reportValidity()) return; if (file.size > 5_000_000) return setStatus("Choose a file smaller than 5 MB.", true); const button = form.querySelector<HTMLButtonElement>('button[type="submit"]'); if (button) button.disabled = true; setStatus("Sanitizing the file in your browser…");
    try { if (file.type === "text/csv" || file.name.toLowerCase().endsWith(".csv")) { renderDraft(parseCsv(await file.text())); resetTurnstile(); return; } const sanitized = file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf") ? await sanitizePdf(file) : await sanitizeImage(file); if (sanitized.size > 5_000_000) throw new Error("The sanitized image is still too large. Try a smaller file."); const data = new FormData(); data.set("menu", new File([sanitized], "sanitized-menu.jpg", { type: "image/jpeg" })); data.set("company", String(new FormData(form).get("company") || "")); data.set("cf-turnstile-response", String(new FormData(form).get("cf-turnstile-response") || "")); setStatus("Reading items and prices…"); const response = await fetch("/api/menu-import", { method: "POST", body: data, credentials: "same-origin" }); const payload = await response.json() as { ok?: boolean; message?: string; draft?: Draft }; if (!response.ok || !payload.ok || !payload.draft) throw new Error(payload.message || "The menu could not be imported."); renderDraft(payload.draft); resetTurnstile(); } catch (error) { setStatus(error instanceof Error ? error.message : "The menu could not be imported.", true); resetTurnstile(); } finally { if (button) button.disabled = false; }
  });
  document.querySelector("[data-clear]")?.addEventListener("click", () => clearDraft());
  document.querySelector("[data-add-item]")?.addEventListener("click", () => { if (!draft) return; addEditor({ id: crypto.randomUUID(), category: "Menu", name: "", description: "", priceCents: null, confidence: "low" }); touchDraft(); });
  document.querySelector("[data-build-cart]")?.addEventListener("click", renderCart);
</script>

<style>
  .menu-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 360px); gap: var(--space-lg); align-items: end; padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg); }
  .menu-hero h1 { max-width: 880px; margin-top: 0.45rem; letter-spacing: 0; }.menu-hero .lede { max-width: 720px; color: var(--cream-muted); }
  .safety { display: flex; gap: 0.8rem; padding: 1rem; border: 1px solid var(--line-strong); border-radius: 16px; background: rgba(6,27,20,.66); }.safety > :global(svg) { flex: 0 0 auto; color: var(--rust-light); }.safety p { margin: .25rem 0 0; color: var(--cream-muted); font-size: var(--step--1); }
  .builder-shell { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, .7fr); gap: var(--space-md); padding-top: 0; }.upload-card,.boundary-card { padding: clamp(1.2rem,4vw,2rem); border: 1px solid var(--line); border-radius: 20px; background: rgba(6,27,20,.62); }.upload-head { display:flex; gap:.8rem; align-items:flex-start; }.upload-head > :global(svg){ color:var(--rust-light); }.upload-head h2 { margin:0; letter-spacing:0; }.upload-head p { color:var(--cream-muted); }
  .file-drop { display:grid; gap:.35rem; margin:1rem 0; padding:1.2rem; border:1px dashed var(--line-strong); border-radius:14px; background:rgba(244,238,220,.035); cursor:pointer; }.file-drop input { width:100%; }.file-drop span { font-weight:850; }.file-drop small { color:var(--cream-muted); }.consent { display:flex; gap:.65rem; align-items:flex-start; color:var(--cream-muted); }.consent input { margin-top:.35rem; }.upload-card .btn { margin-top:1rem; }.form-status { min-height:1.5rem; margin:.8rem 0 0; color:var(--cream-muted); }.form-status.error { color:#ffb2a0; }
  .boundary-card ul { display:grid; gap:.55rem; padding:0; list-style:none; }.boundary-card li { display:flex; gap:.5rem; align-items:center; color:var(--cream-muted); }.boundary-card li :global(svg){ color:var(--rust-light); }.boundary-card p { color:var(--cream-muted); }.boundary-card a { display:inline-flex; gap:.3rem; align-items:center; font-weight:850; }
  .draft,.cart { padding-top:var(--space-md); }.draft-head { display:flex; justify-content:space-between; gap:var(--space-md); align-items:end; margin-bottom:var(--space-md); }.draft-head h2,.cart-head h2 { margin-top:.35rem; letter-spacing:0; }.draft-head p,.cart-head p { color:var(--cream-muted); }.warnings { padding:.8rem 1rem; margin-bottom:1rem; border:1px solid rgba(219,110,66,.45); border-radius:12px; background:rgba(219,110,66,.08); }.warnings p { margin:0; }.business-name { display:grid; gap:.35rem; max-width:520px; margin-bottom:1rem; }.business-name span,.item-editor label span { font-weight:800; font-size:var(--step--1); }
  .items { display:grid; gap:.8rem; }.item-editor { position:relative; display:grid; gap:.75rem; padding:1rem; border:1px solid var(--line); border-radius:16px; background:rgba(6,27,20,.56); }.confidence { width:fit-content; border-radius:999px; padding:.2rem .5rem; font:800 .66rem/1.4 var(--mono); text-transform:uppercase; background:rgba(219,110,66,.1); color:var(--rust-light); }.confidence.high { color:#b8ffc8; background:rgba(94,171,116,.15); }.editor-grid { display:grid; grid-template-columns:1fr 1.3fr 2fr .7fr; gap:.65rem; }.editor-grid label { display:grid; gap:.3rem; }.editor-grid input { width:100%; min-width:0; padding:.65rem .75rem; border:1px solid var(--line); border-radius:10px; background:rgba(244,238,220,.055); color:var(--cream); font:inherit; }.item-editor > button { width:fit-content; border:0; padding:0; background:none; color:var(--rust-light); font:inherit; font-weight:800; cursor:pointer; }.draft-actions { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.75rem; margin-top:1rem; }
  .catalog { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr)); gap:var(--space-md); }.catalog article { display:grid; align-content:start; gap:.45rem; padding:1rem; border:1px solid var(--line); border-radius:16px; background:rgba(244,238,220,.045); }.catalog span { color:var(--rust-light); font:800 .68rem/1.3 var(--mono); text-transform:uppercase; }.catalog h3 { margin:0; font-size:var(--step-1); letter-spacing:0; }.catalog p { margin:0; color:var(--cream-muted); }.catalog button { width:fit-content; margin-top:.35rem; border:1px solid var(--line-strong); border-radius:999px; padding:.45rem .8rem; background:var(--forest-600); color:var(--cream); font:inherit; font-weight:850; cursor:pointer; }.catalog button:disabled { opacity:.45; cursor:not-allowed; }
  .cart-summary { position:sticky; bottom:1rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-top:1rem; padding:1rem; border:1px solid var(--line-strong); border-radius:16px; background:var(--forest-900); box-shadow:var(--shadow-md); }.cart-summary span,.cart-summary strong { display:block; }.cart-summary button { border:0; border-radius:999px; padding:.7rem 1rem; background:rgba(244,238,220,.1); color:var(--cream-muted); font:inherit; font-weight:850; }.cart-cta { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-top:var(--space-md); }.cart-cta p { max-width:620px; margin:0; color:var(--cream-muted); }
  @media(max-width:850px){.menu-hero,.builder-shell{grid-template-columns:1fr}.editor-grid{grid-template-columns:1fr 1fr}.cart-cta{display:grid}.draft-head{align-items:start}}
  @media(max-width:560px){.editor-grid{grid-template-columns:1fr}.cart-summary{align-items:stretch;display:grid}.cart-summary button{width:100%}}
</style>
