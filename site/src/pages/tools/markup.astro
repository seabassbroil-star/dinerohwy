---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

// Static preview page only. Markup is a local-first tool that runs on the
// operator's machine, not on this site — so there are deliberately NO inputs,
// NO file upload, and NO wired actions here. Everything below is a mockup.
const steps = [
  { n: "01", title: "Drop it in", body: "Start with any screenshot or image — it never leaves the browser." },
  { n: "02", title: "Mark the spot", body: "Circle, underline, or point to exactly what you mean, right on the image." },
  { n: "03", title: "Add your note", body: "Write the feedback while the context is still right there, then export or share a link." },
] as const;
---

<BaseLayout
  title="Markup — Visual review, kept simple - DineroHWY"
  description="Drop in a screenshot, mark the exact spot, and write your feedback in one place. A preview of the Markup visual-review tool."
>
  <section class="mk-hero container">
    <div class="mk-hero-copy">
      <span class="eyebrow">Markup · Visual review</span>
      <h1>Point at the thing. Say what you mean.</h1>
      <p class="lede">
        Drop in a screenshot, mark the exact spot, and write your feedback — without
        juggling three different apps. A faster feedback loop for design cleanup and QA.
      </p>

      <div class="mk-actions">
        <span class="btn btn-primary is-disabled" role="button" aria-disabled="true">
          Open Markup <Icon name="arrow-right" size={17} />
        </span>
        <span class="mk-status">
          <span class="mk-dot" aria-hidden="true"></span>
          Preview — this feature isn't wired up yet
        </span>
      </div>

      <p class="mk-note">
        Markup is a local-first tool: it runs on the machine doing the review so images
        never leave the browser. This page is a static preview of the interface — nothing
        here uploads, saves, or connects to anything.
      </p>
    </div>

    <!-- Decorative, non-interactive mockup of the Markup interface. -->
    <div class="mk-window" aria-hidden="true">
      <div class="mk-chrome">
        <span></span><span></span><span></span>
        <em>homepage.png — reviewing</em>
      </div>

      <div class="mk-stage">
        <div class="mk-shot">
          <div class="mk-shot-bar">
            <span class="mk-shot-logo"></span>
            <span class="mk-shot-nav"></span>
            <span class="mk-shot-nav"></span>
            <span class="mk-shot-nav"></span>
          </div>
          <div class="mk-shot-hero">
            <div class="mk-line mk-h"></div>
            <div class="mk-line mk-w80"></div>
            <div class="mk-line mk-w60"></div>
            <div class="mk-shot-cta"></div>
          </div>

          <svg class="mk-ink" viewBox="0 0 600 360" preserveAspectRatio="none" fill="none">
            <ellipse cx="176" cy="120" rx="104" ry="34" stroke="#ef4444" stroke-width="4" stroke-linecap="round" />
            <path d="M300 300 C 350 300, 372 292, 392 274" stroke="#2563eb" stroke-width="4" stroke-linecap="round" />
            <path d="M392 274 l -14 2 m 14 -2 l -4 -13" stroke="#2563eb" stroke-width="4" stroke-linecap="round" />
          </svg>
          <span class="mk-marker mk-m1">1</span>
          <span class="mk-marker mk-m2">2</span>
        </div>
      </div>

      <div class="mk-feedback">
        <p class="mk-fb-title">Feedback</p>
        <div class="mk-route"></div>
        <ul class="mk-fb-list">
          <li><span class="mk-chip mk-c1">1</span><p>Headline is too generic — lead with the neighborhood and the offer.</p></li>
          <li><span class="mk-chip mk-c2">2</span><p>The primary button gets lost. Make it the rust CTA and lift it above the fold.</p></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section container mk-steps" aria-label="How Markup works">
    <div class="mk-steps-head">
      <span class="eyebrow">How it works</span>
      <h2>Three moves, one window.</h2>
    </div>
    <div class="mk-steps-grid">
      {steps.map((step) => (
        <article class="mk-step">
          <span class="mk-step-n">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section container mk-cta-band">
    <div class="mk-cta-inner">
      <div>
        <h2>Coming to the toolkit.</h2>
        <p>Markup ships as part of the DineroHWY build workflow. This preview shows the
        interface; the live tool runs locally during a review.</p>
      </div>
      <a class="mk-back" href="/tools">Back to tools <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .mk-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 0.82fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 6rem) var(--space-lg);
  }
  .mk-hero-copy h1 { max-width: 15ch; margin-top: 0.45rem; }
  .mk-hero-copy .lede { max-width: 46ch; color: var(--cream-muted); }

  .mk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.15rem;
    margin-top: var(--space-md);
  }
  /* A deliberately inert CTA — looks like the button, does nothing. */
  .btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    filter: grayscale(0.15);
    pointer-events: none;
    user-select: none;
  }
  .mk-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cream-muted);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.02em;
  }
  .mk-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--rust-light);
    box-shadow: 0 0 0 4px rgba(219, 110, 66, 0.16);
  }
  .mk-note {
    max-width: 52ch;
    margin-top: var(--space-md);
    color: var(--cream-dim);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Mockup window --------------------------------------------------------- */
  .mk-window {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(40, 84, 64, 0.3), rgba(6, 27, 20, 0.42));
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .mk-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: rgba(6, 27, 20, 0.5);
  }
  .mk-chrome span { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .mk-chrome span:first-child { background: #e0674b; }
  .mk-chrome em {
    margin-left: 0.6rem;
    color: var(--cream-dim);
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
  }
  .mk-stage { padding: clamp(0.9rem, 2.4vw, 1.4rem); }

  /* Faux screenshot with annotation overlay */
  .mk-shot {
    position: relative;
    border-radius: var(--radius-md);
    background: #e6e4dd; /* neutral mat, like the real canvas */
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    aspect-ratio: 5 / 3;
  }
  .mk-shot-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.9rem;
    background: #fbfaf6;
    border-bottom: 1px solid rgba(11, 45, 34, 0.08);
  }
  .mk-shot-logo { width: 30px; height: 10px; border-radius: 3px; background: #0b2d22; }
  .mk-shot-nav { width: 26px; height: 7px; border-radius: 3px; background: rgba(11, 45, 34, 0.22); }
  .mk-shot-nav:first-of-type { margin-left: auto; }
  .mk-shot-hero { padding: clamp(1.1rem, 4vw, 2.2rem); display: grid; gap: 0.7rem; }
  .mk-line { height: 12px; border-radius: 5px; background: rgba(11, 45, 34, 0.16); }
  .mk-line.mk-h { height: 22px; width: 62%; background: rgba(11, 45, 34, 0.34); }
  .mk-line.mk-w80 { width: 80%; }
  .mk-line.mk-w60 { width: 54%; }
  .mk-shot-cta { margin-top: 0.5rem; width: 116px; height: 30px; border-radius: 999px; background: rgba(11, 45, 34, 0.2); }

  .mk-ink { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .mk-marker {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26px; height: 26px;
    border-radius: 50%;
    color: #fff;
    font: 800 0.78rem/1 var(--sans);
    box-shadow: 0 4px 10px rgba(2, 15, 10, 0.35);
  }
  .mk-marker.mk-m1 { top: 12%; left: 6%; background: #ef4444; }
  .mk-marker.mk-m2 { bottom: 8%; left: 46%; background: #2563eb; }

  /* Feedback panel — forest ground, cream text, rust title (matches export) */
  .mk-feedback {
    padding: clamp(1rem, 3vw, 1.5rem);
    background: #0b2d22;
    border-top: 1px solid var(--line);
  }
  .mk-fb-title {
    margin: 0;
    color: var(--rust-light);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .mk-route { width: 96px; height: 3px; margin: 0.5rem 0 0.9rem; border-radius: 999px; background: var(--rust); }
  .mk-fb-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .mk-fb-list li { display: flex; gap: 0.8rem; align-items: flex-start; }
  .mk-fb-list p { margin: 0; color: var(--cream); line-height: 1.5; }
  .mk-chip {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 24px; height: 24px;
    border-radius: 50%;
    color: #fff;
    font: 800 0.76rem/1 var(--sans);
  }
  .mk-chip.mk-c1 { background: #ef4444; }
  .mk-chip.mk-c2 { background: #2563eb; }

  /* Steps ----------------------------------------------------------------- */
  .mk-steps { display: grid; gap: var(--space-lg); padding-top: 0; }
  .mk-steps-head h2 { margin: 0.35rem 0 0; letter-spacing: 0; }
  .mk-steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .mk-step {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    background: rgba(6, 27, 20, 0.55);
  }
  .mk-step-n { color: var(--rust-light); font-family: var(--mono); font-size: 0.8rem; font-weight: 900; }
  .mk-step h3 { margin: 0.7rem 0 0.4rem; font-size: var(--step-1); letter-spacing: 0; }
  .mk-step p { margin: 0; color: var(--cream-muted); }

  /* Closing band ---------------------------------------------------------- */
  .mk-cta-band { padding-top: 0; }
  .mk-cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: clamp(1.4rem, 4vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(219, 110, 66, 0.1), transparent 45%), rgba(6, 27, 20, 0.6);
  }
  .mk-cta-inner h2 { margin: 0 0 0.35rem; font-size: var(--step-2); letter-spacing: 0; }
  .mk-cta-inner p { margin: 0; max-width: 52ch; color: var(--cream-muted); }
  .mk-back { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--cream); font-weight: 850; }
  .mk-back:hover { color: var(--rust-light); }

  @media (max-width: 900px) {
    .mk-hero { grid-template-columns: 1fr; }
    .mk-steps-grid { grid-template-columns: 1fr; }
  }
</style>
