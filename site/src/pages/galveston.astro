---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import Icon from "../components/Icon.astro";

// Galveston 1x1x1 landing page — the destination for QR codes, cards, stickers.
// One avatar (island business owner) x one offer (free Report Card) x the local
// bootstrapping channel. Report Card capture is tagged source=galveston so scans
// are attributable in D1.
const stats = [
  { value: "8.9M", label: "visitors a year" },
  { value: "$1.3B", label: "they spend on the island" },
  { value: "1 in 3", label: "island jobs is tourism" },
];

const steps = [
  { icon: "seo", title: "Get found by visitors", body: "8.9 million people search 'where to eat / what to do in Galveston' every year. We make sure your business is what they find." },
  { icon: "quote", title: "Turn lookers into customers", body: "A fast, mobile site that answers questions, takes bookings, and captures the ones who would've scrolled past." },
  { icon: "email", title: "Keep them coming back", body: "Tourists leave, but a simple follow-up brings locals and repeat visitors back to your door." },
];
---

<BaseLayout
  title="Galveston businesses: get found by 8.9M visitors | Dinero Hwy"
  description="Dinero Hwy builds websites and automation for Galveston businesses — so the island's 8.9 million yearly visitors find you first. Free Report Card, no pitch."
>
  <section class="gv-hero section">
    <div class="motif-glow" aria-hidden="true"></div>
    <div class="container gv-inner">
      <span class="eyebrow">Galveston Island · locally built</span>
      <h1>8.9 million visitors a year. Do they find <em>your</em> business?</h1>
      <p class="lede">
        Galveston runs on tourism — and the businesses that show up online are the
        ones those visitors walk into. We build the website and the software that
        gets you found, books the job, and follows up. <strong>You run the shop.</strong>
      </p>

      <div class="gv-cta card">
        <h2>Start with a free Galveston Report Card.</h2>
        <p>Your website &amp; Google presence, graded for how well island visitors can find you — plus 3 specific fixes. No cost, no pitch.</p>
        <EmailCapture
          variant="inline"
          magnet="report-card"
          source="galveston-landing"
          collectBusiness={true}
          heading=""
          sub=""
          buttonLabel="Grade my business — free"
        />
      </div>

      <div class="gv-stats">
        {stats.map((s) => (
          <div class="gv-stat"><span class="gv-stat-v">{s.value}</span><span class="gv-stat-l">{s.label}</span></div>
        ))}
        <p class="gv-source">Source: Visit Galveston, 2024 annual report.</p>
      </div>
    </div>
  </section>

  <section class="section container">
    <span class="eyebrow">What it does for an island business</span>
    <h2>Made to catch tourist traffic.</h2>
    <div class="gv-grid">
      {steps.map((s, i) => (
        <div class="gv-card">
          <span class="gv-num">{i + 1}</span>
          <span class="gv-icon"><Icon name={s.icon} size={22} /></span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container gv-local">
    <div class="card">
      <span class="eyebrow">Local, on the island</span>
      <h2>Built here, by hand — with a person you can meet.</h2>
      <p class="lede">
        No agency, no call center. Real websites on Cloudflare, built with today's
        best AI and old-fashioned care. Want to talk in person? That's the whole point —
        come find us, or scan and we'll come to you.
      </p>
      <EmailCapture variant="inline" magnet="report-card" source="galveston-landing-2" heading="" sub="" collectBusiness={true} buttonLabel="Get my free Report Card" />
    </div>
  </section>
</BaseLayout>

<script>
  // Attribute the QR/card placement: rewrite the capture form's source to
  // galveston-<utm_source> (e.g. galveston-sticker) so D1 shows what converted.
  const utm = new URLSearchParams(location.search).get("utm_source");
  if (utm) {
    const safe = utm.replace(/[^a-z0-9-]/gi, "").slice(0, 24);
    document.querySelectorAll('form[data-capture] input[name="source"]').forEach((el) => {
      (el as HTMLInputElement).value = `galveston-${safe}`;
    });
  }
</script>

<style>
  .gv-hero { position: relative; padding-top: var(--space-2xl); overflow: hidden; }
  .gv-inner { display: grid; justify-items: start; gap: 1rem; max-width: 820px; }
  .gv-hero h1 em { color: var(--rust-light); font-style: normal; }
  .gv-cta { width: 100%; max-width: 620px; display: grid; gap: 0.5rem; margin-top: 0.5rem; }
  .gv-cta :global(.capture-row) { margin-top: 0.5rem; }

  .gv-stats { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); width: 100%; }
  .gv-stat { display: grid; }
  .gv-stat-v { font-family: var(--condensed); font-weight: 700; font-size: var(--step-3); color: var(--cream); line-height: 1; }
  .gv-stat-l { font-size: var(--step--1); color: var(--cream-muted); }
  .gv-source { width: 100%; margin: 0; font-size: 11px; color: var(--cream-muted); }

  .gv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-top: var(--space-md); }
  .gv-card { position: relative; padding: 1.5rem 1.25rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(6,27,20,.3); }
  .gv-num { position: absolute; top: -14px; left: 1.25rem; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--rust); color: var(--cream); font-weight: 800; font-size: 14px; }
  .gv-icon { display: inline-flex; color: var(--rust-light); margin-bottom: 0.5rem; }
  .gv-card h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .gv-card p { color: var(--cream-muted); margin: 0; }
  .gv-local .card { text-align: left; }
  @media (max-width: 760px) { .gv-grid { grid-template-columns: 1fr; } }
</style>
