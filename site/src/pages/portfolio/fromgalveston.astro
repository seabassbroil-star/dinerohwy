---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const lanes = [
  {
    label: "Visitor Utility",
    body: "Pages are organized around what a Galveston visitor actually needs: cruise timing, beach decisions, food, and what is nearby.",
  },
  {
    label: "Local Search",
    body: "The structure supports searchable pages, useful internal links, and content that can grow without turning into a cluttered directory.",
  },
  {
    label: "Product Proof",
    body: "It gives DineroHWY a real local product to optimize instead of only showing mockups or disconnected experiments.",
  },
];
---

<BaseLayout
  title="fromGalveston Case Study"
  description="A fromGalveston case study showing Galveston-focused site building, local content structure, and optimization workflow."
>
  <section class="case-hero container">
    <span class="eyebrow">Case Study</span>
    <h1>fromGalveston is the local proof piece.</h1>
    <p class="lede">
      A Galveston visitor product built around the coast, cruise traffic, local
      discovery, and the kind of practical content that can earn search attention.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="https://fromgalveston.com" target="_blank" rel="noopener">
        View Live Site <Icon name="arrow-up-right" size={17} />
      </a>
      <a class="btn btn-ghost" href="/portfolio">Back to Portfolio</a>
    </div>
  </section>

  <section class="section container site-frame">
    <div class="frame-top" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="frame-body">
      <div>
        <span class="eyebrow">fromGalveston</span>
        <strong>Galveston pages built for real visitors.</strong>
      </div>
      <div class="frame-tags">
        <span>Cruise</span>
        <span>Seawall</span>
        <span>Food</span>
        <span>Events</span>
      </div>
    </div>
  </section>

  <section class="section container lanes">
    {lanes.map((lane) => (
      <article>
        <span>{lane.label}</span>
        <p>{lane.body}</p>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg);
  }

  .case-hero h1 {
    max-width: 820px;
    margin-top: 0.45rem;
    letter-spacing: 0;
  }

  .case-hero .lede {
    max-width: 720px;
    color: var(--cream-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .site-frame {
    padding-top: 0;
  }

  .frame-top,
  .frame-body {
    border: 1px solid var(--line);
  }

  .frame-top {
    display: flex;
    gap: 0.42rem;
    padding: 0.8rem;
    border-radius: 18px 18px 0 0;
    background: rgba(6, 27, 20, 0.74);
  }

  .frame-top span {
    width: 0.7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream-muted);
  }

  .frame-body {
    min-height: 380px;
    display: grid;
    align-content: end;
    gap: var(--space-md);
    padding: clamp(1.35rem, 4vw, 3rem);
    border-top: 0;
    border-radius: 0 0 18px 18px;
    background:
      linear-gradient(160deg, rgba(53, 141, 143, 0.35), transparent 46%),
      linear-gradient(180deg, rgba(219, 110, 66, 0.2), rgba(6, 27, 20, 0.92)),
      url("/assets/concepts/coast-texas-seawall-dinero-exit-clean.png?v=1") center / cover;
    box-shadow: var(--shadow-md);
  }

  .frame-body strong {
    display: block;
    max-width: 760px;
    margin-top: 0.4rem;
    font-size: clamp(2.2rem, 6vw, 5rem);
    line-height: 0.9;
    letter-spacing: 0;
    text-shadow: 0 6px 26px rgba(2, 15, 10, 0.76);
  }

  .frame-tags,
  .lanes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.7rem;
  }

  .frame-tags span,
  .lanes article {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem;
    background: rgba(6, 27, 20, 0.64);
    color: var(--cream);
    font-weight: 850;
  }

  .lanes {
    grid-template-columns: repeat(3, 1fr);
    padding-top: 0;
  }

  .lanes article span {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--rust-light);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .lanes article p {
    margin: 0;
    color: var(--cream-muted);
  }

  @media (max-width: 820px) {
    .frame-tags,
    .lanes {
      grid-template-columns: 1fr;
    }
  }
</style>
