---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const projects = [
  {
    title: "fromGalveston",
    href: "/portfolio/fromgalveston",
    live: "https://fromgalveston.com",
    status: "In development",
    type: "Galveston visitor site",
    summary: "A cruise-first local media product for Galveston visitors, built around useful pages, local discovery, and fast publishing.",
    preview: ["Cruise", "Beach", "Eat + Drink", "What’s on"],
  },
  {
    title: "DineroHWY",
    href: "/portfolio/dinerohwy",
    live: "/",
    status: "Live",
    type: "Developer portfolio",
    summary: "The site you are on: brand system, lead capture, email follow-up, report-card tooling, and public GitHub proof.",
    preview: ["Portfolio", "Tools", "Report Card", "GitHub"],
  },
  {
    title: "Website Report Card",
    href: "/report-card",
    live: "/report-card",
    status: "Live tool",
    type: "Optimization workflow",
    summary: "A website grader that turns a business URL into a score, prioritized fixes, and a practical conversation starter.",
    preview: ["HTTPS", "Mobile", "Local SEO", "Speed"],
  },
];
---

<BaseLayout
  title="Portfolio - DineroHWY"
  description="Portfolio pages for DineroHWY: real websites, tools, and developer proof from Galveston with Ecuador roots."
>
  <section class="page-hero container">
    <span class="eyebrow">Portfolio</span>
    <h1>Sites built to prove the work, not just describe it.</h1>
    <p class="lede">
      These are the public-facing products I am building while I build the software
      around them: grading, optimization, lead capture, deployment, and follow-up.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/tools">View Tools <Icon name="arrow-right" size={17} /></a>
      <a class="btn btn-ghost" href="https://github.com/seabassbroil-star" target="_blank" rel="noopener">
        <Icon name="github" size={18} /> GitHub
      </a>
    </div>
  </section>

  <section class="section container work-list" aria-label="Portfolio projects">
    {projects.map((project) => (
      <article class="project">
        <a class="site-preview" href={project.href} aria-label={`Open ${project.title} case study`}>
          <div class="browser-bar" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <div class="preview-body">
            <strong>{project.title}</strong>
            <div class="preview-tags">
              {project.preview.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </a>
        <div class="project-copy">
          <div class="project-meta">
            <span>{project.type}</span>
            <b>{project.status}</b>
          </div>
          <h2>{project.title}</h2>
          <p>{project.summary}</p>
          <div class="project-actions">
            <a class="btn btn-primary" href={project.href}>Case Study <Icon name="arrow-right" size={17} /></a>
            <a class="btn btn-ghost" href={project.live} target={project.live.startsWith("http") ? "_blank" : undefined} rel={project.live.startsWith("http") ? "noopener" : undefined}>
              View Site <Icon name="arrow-up-right" size={17} />
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg);
  }

  .page-hero h1 {
    max-width: 850px;
    margin-top: 0.5rem;
    letter-spacing: 0;
  }

  .page-hero .lede {
    max-width: 720px;
    color: var(--cream-muted);
  }

  .hero-actions,
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .work-list {
    display: grid;
    gap: var(--space-lg);
    padding-top: 0;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: stretch;
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .site-preview {
    min-height: 310px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background:
      linear-gradient(155deg, rgba(219, 110, 66, 0.18), transparent 42%),
      linear-gradient(180deg, rgba(40, 84, 64, 0.95), rgba(6, 27, 20, 0.9));
    box-shadow: var(--shadow-md);
  }

  .browser-bar {
    display: flex;
    gap: 0.42rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--line);
    background: rgba(6, 27, 20, 0.44);
  }

  .browser-bar span {
    width: 0.68rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream-muted);
  }

  .preview-body {
    min-height: 250px;
    display: grid;
    align-content: end;
    gap: 1.1rem;
    padding: 1.35rem;
  }

  .preview-body strong {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .preview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .preview-tags span,
  .project-meta span,
  .project-meta b {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.62rem;
    color: var(--cream);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 850;
  }

  .project-copy {
    align-self: center;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .project-meta b {
    background: rgba(219, 110, 66, 0.16);
    color: var(--rust-light);
  }

  .project-copy h2 {
    letter-spacing: 0;
  }

  .project-copy p {
    max-width: 620px;
    color: var(--cream-muted);
  }

  @media (max-width: 840px) {
    .project {
      grid-template-columns: 1fr;
    }

    .site-preview {
      min-height: 260px;
    }
  }
</style>
