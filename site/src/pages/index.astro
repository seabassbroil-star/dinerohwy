---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import PainStrip from "../components/PainStrip.astro";
import SolutionCard from "../components/SolutionCard.astro";
import StatStrip from "../components/StatStrip.astro";
import Icon from "../components/Icon.astro";
import AIStack from "../components/AIStack.astro";

const wins = [
  { icon: "assistant", title: "Answer every customer — even after hours", body: "When you're busy or closed, your site picks up: it replies, books, and captures the details. Every knock gets answered." },
  { icon: "quote", title: "Quote in minutes, win the job", body: "A customer sends a photo and gets a price on the spot — while they're still deciding. Fast quotes win work." },
  { icon: "email", title: "Bring past customers back", body: "The people who already love you are your easiest next sale. A simple follow-up brings them back around." },
] as const;

const solutions = [
  { href: "/showcase", icon: "website", title: "Showcase Sites", blurb: "Fast, real websites that sell — not brochures. See live examples.", status: "live" },
  { href: "/review-app", icon: "review", title: "Review App", blurb: "Screenshot any page, drop notes, ship the fix. The cockpit we build with.", status: "live" },
  { href: "/image-quote", icon: "quote", title: "Instant Quotes", blurb: "A customer uploads a photo and gets a price in minutes. Try it yourself.", status: "live" },
  { href: "/seo-assistant", icon: "seo", title: "SEO Assistant", blurb: "Find the easiest thing to rank for, ship it, and watch what moves.", status: "coming-soon" },
  { href: "/intel-assistant", icon: "intel", title: "Intel Assistant", blurb: "An AI that knows your business and answers customers day and night.", status: "coming-soon" },
  { href: "/book", icon: "book", title: "Agentic AI, for kids", blurb: "Learn how these tools work — explained simply, with a live demo per idea.", status: "live" },
] as const;

const stats = [
  { value: "3 min", label: "avg quote delivery" },
  { value: "24/7", label: "AI assistant" },
  { value: "100%", label: "of leads followed up" },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero section">
    <div class="motif-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow">internet + dinero</span>
      <h1>Get found. Get booked. Grow.</h1>
      <p class="lede">
        Dinero Hwy builds the software that turns your website into a machine —
        it answers customers, sends quotes, and follows up while you run the shop.
        <strong>We build the internet part. You collect the dinero.</strong>
      </p>

      <EmailCapture
        variant="hero"
        magnet="report-card"
        source="home-hero"
        collectBusiness={true}
        heading=""
        sub=""
      />
      <p class="hero-fineprint">Free Website &amp; Google Report Card — your business graded, plus 3 fixes. No pitch.</p>

      <p class="hero-ai"><AIStack label="Powered by the world's most advanced AI" /> <span class="hero-ai-human">— with a human you can meet.</span></p>

      <div class="hero-stats">
        <StatStrip items={stats} />
      </div>
    </div>
  </section>

  <!-- OPPORTUNITY STRIP -->
  <section class="section container">
    <span class="eyebrow">Hiding in plain sight</span>
    <h2>Three easy wins already sitting in your business.</h2>
    <div class="stack">
      <PainStrip items={wins} />
    </div>
  </section>

  <!-- GROWTH THESIS -->
  <section class="section container growth">
    <span class="eyebrow">The untapped part</span>
    <h2>The best shop in town shouldn't be the best-kept secret.</h2>
    <p class="lede">
      You've got the customers, the reputation, and years of knowing exactly what you're doing.
      The only thing missing is a place online where new people can find you — and that's not
      falling behind. It's a business that's been holding its breath.
    </p>
    <p class="growth-punch">The day it shows up where everyone's already looking, <b>it grows.</b></p>
    <p class="growth-thesis">You know your business. We know how to put it online. That's the whole deal.</p>
    <a class="btn btn-primary" href="/get-online">See how it works <Icon name="arrow-right" size={16} /></a>
  </section>

  <!-- SOLUTIONS -->
  <section id="tools" class="section container">
    <span class="eyebrow">The toolbox</span>
    <h2>Every tool we sell runs live on this site.</h2>
    <p class="lede">Don't take our word for it — try them. That's the whole pitch.</p>
    <div class="solutions-grid">
      {solutions.map((s) => <SolutionCard {...s} />)}
    </div>
  </section>

  <!-- GET ONLINE TEASER -->
  <section class="section container">
    <a class="getonline" href="/get-online">
      <div>
        <span class="eyebrow">Watch: 35 seconds</span>
        <h2>Invest $12 a year in digital real estate — and watch it grow.</h2>
        <p class="lede">For about $12/yr you own your spot on the map (domain &amp; hosting on Cloudflare). The site itself, we build for you, priced to fit. You don't touch a keyboard.</p>
        <span class="getonline-cta">Play the ad <Icon name="arrow-right" size={18} /></span>
      </div>
      <div class="getonline-art" aria-hidden="true">
        <span class="route-bar"></span>
        <span class="getonline-tag"><b>$12</b>/yr</span>
      </div>
    </a>
  </section>

  <!-- PROOF -->
  <section class="section container proof">
    <div class="proof-card card">
      <div>
        <span class="eyebrow">Real software, not templates</span>
        <h2>Built in the open.</h2>
        <p class="lede">
          This whole site — the quote demo, the review app, the email engine —
          is real code running on Cloudflare. Inspect it, fork it, or just watch it work.
        </p>
        <p class="proof-ai">We build with the most advanced AI models on Earth — <b>Claude, ChatGPT, and Grok</b> — so a small local shop gets big-agency work at a price that makes sense.</p>
        <div class="proof-actions">
          <a class="btn btn-ghost" href="/work">
            <Icon name="code" size={18} /> See the work
          </a>
          <a class="btn btn-ghost" href="https://github.com" target="_blank" rel="noopener">
            <Icon name="code" size={18} /> View the code
          </a>
        </div>
      </div>
      <div class="proof-route" aria-hidden="true">
        <div class="route-bar"></div>
        <span class="star-badge" style="width:44px;height:44px"></span>
        <div class="route-bar"></div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section container final-cta">
    <h2>Get your free Report Card.</h2>
    <p class="lede">Enter your email and we'll grade your website and Google presence — with 3 specific fixes you can make this week.</p>
    <EmailCapture variant="inline" magnet="report-card" source="home-footer-cta" collectBusiness={true} heading="" sub="" />
  </section>
</BaseLayout>

<style>
  .hero { position: relative; padding-top: var(--space-2xl); overflow: hidden; }
  .hero-inner { display: grid; justify-items: start; gap: 1rem; max-width: 780px; }
  .hero h1 { margin: 0.2rem 0; }
  .hero-fineprint { color: var(--cream-muted); font-size: var(--step--1); margin: 0.25rem 0 0; }
  .hero-ai { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; margin: 0.75rem 0 0; }
  .hero-ai-human { color: var(--cream-muted); font-size: var(--step--1); font-weight: 700; }
  .proof-ai { color: var(--cream-muted); margin: 0.75rem 0 0; max-width: 52ch; }
  .proof-ai b { color: var(--cream); }
  .hero-stats { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); width: 100%; }
  .hero-stats :global(.stats) { justify-content: flex-start; }

  .growth { max-width: 760px; }
  .growth .lede { margin-top: 0.75rem; }
  .growth-punch { font-size: var(--step-2); font-weight: 800; letter-spacing: -0.02em; margin: 1.25rem 0 0.5rem; text-wrap: balance; }
  .growth-punch b { color: var(--rust-light); }
  .growth-thesis { color: var(--cream-muted); font-size: var(--step-1); margin: 0 0 1.5rem; }

  .solutions-grid {
    margin-top: var(--space-md);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 900px) { .solutions-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .solutions-grid { grid-template-columns: 1fr; } }

  .proof-card { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-lg); align-items: center; }
  .proof-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .proof-route { display: grid; justify-items: center; gap: 1rem; }
  @media (max-width: 760px) { .proof-card { grid-template-columns: 1fr; } .proof-route { display: none; } }

  .getonline {
    display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-lg); align-items: center;
    padding: clamp(1.5rem, 4vw, 2.75rem); border-radius: var(--radius-lg);
    border: 1px solid var(--line); background: linear-gradient(160deg, rgba(40,84,64,.28), rgba(6,27,20,.34));
    transition: border-color .16s, transform .16s;
  }
  .getonline:hover { border-color: var(--line-strong); transform: translateY(-2px); color: var(--cream); }
  .getonline-cta { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1rem; color: var(--rust-light); font-weight: 800; }
  .getonline-art { position: relative; display: grid; place-items: center; min-height: 120px; }
  .getonline-art .route-bar { width: 80%; }
  .getonline-tag { position: absolute; padding: .6rem 1rem; border-radius: 12px; background: linear-gradient(160deg, var(--rust-light), var(--rust-deep)); color: var(--cream); font-weight: 700; box-shadow: var(--shadow-md); }
  .getonline-tag b { font-family: var(--condensed); font-size: 1.8rem; }
  @media (max-width: 760px) { .getonline { grid-template-columns: 1fr; } .getonline-art { display: none; } }

  .final-cta { max-width: 640px; text-align: center; }
  .final-cta :global(.capture) { justify-items: center; }
  .final-cta :global(.capture-row) { justify-content: center; }
</style>
