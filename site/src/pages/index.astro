---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const featured = [
  {
    title: "Markup Visual Review",
    type: "Featured tool",
    href: "/tools/markup",
    body: "Mark a screenshot and export clear feedback while the image stays in your browser.",
  },
  {
    title: "Menu & Checkout Builder",
    type: "Featured tool",
    href: "/tools/menu",
    body: "Upload a menu and turn it into an editable, browse-only cart preview.",
  },
  {
    title: "fromGalveston",
    type: "Local media site",
    href: "/portfolio/fromgalveston",
    body: "A Galveston visitor site built as a real publishing product, not a mockup.",
  },
  {
    title: "DineroHWY",
    type: "This portfolio system",
    href: "/portfolio/dinerohwy",
    body: "The brand, lead flow, email engine, and Cloudflare build behind this site.",
  },
  {
    title: "Website Report Card",
    type: "Optimization tool",
    href: "/report-card",
    body: "A live grader that checks a business site and turns the audit into next steps.",
  },
];
---

<BaseLayout
  title="DineroHWY - Websites, tools, and optimization"
  description="DineroHWY is a Galveston-based developer portfolio for websites, optimization tools, and software built for local businesses."
  image="/assets/concepts/coast-texas-seawall-dinero-rooster-right.png"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Galveston HQ · GitHub-backed</span>
        <h1 id="hero-title">I build the sites and the software behind them.</h1>
        <p class="lede">
          Dinero Hwy is the proof board for websites, customer-facing tools, and the
          protected operating systems behind them. Try the public work here, then build
          the right version around your business.
        </p>
        <div class="hero-actions">
          <button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">
            <Icon name="email" size={18} /> Email
          </button>
          <button type="button" class="btn btn-ghost" data-textme-open data-intent="quote" aria-haspopup="dialog">
            <Icon name="quote" size={18} /> Quote
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section container grader-widget" aria-labelledby="grader-title">
    <div class="grader-copy">
      <span class="eyebrow">Website Grader</span>
      <h2 id="grader-title">See what customers see before you spend money on a rebuild.</h2>
      <p>
        Enter a business website and DineroHWY checks the basics that actually affect trust:
        mobile setup, calls, search titles, local signals, images, social previews, and speed.
      </p>
    </div>
    <form class="grade-teaser" action="/report-card" method="get">
      <div class="cta-sign-stack" aria-hidden="true">
        <img class="cta-logo" src="/assets/dinerohwy-logo-primary.svg?v=11" alt="" width="520" height="210" />
      </div>
      <label for="home-url">Run a quick site grade</label>
      <div class="teaser-row">
        <input id="home-url" name="url" type="text" maxlength="512" placeholder="yourbusiness.com" autocomplete="url" />
        <button class="btn btn-primary" type="submit">Grade This Site <Icon name="arrow-right" size={17} /></button>
      </div>
      <a class="grader-link" href="/report-card">Open the full grader <Icon name="arrow-right" size={16} /></a>
    </form>
  </section>

  <section class="section container proof-strip" aria-label="Developer proof">
    <div>
      <span class="eyebrow">Portfolio</span>
      <strong>Built sites</strong>
      <p>Live products, case studies, and the business reason behind each build.</p>
    </div>
    <div>
      <span class="eyebrow">Tools</span>
      <strong>Build workflow</strong>
      <p>Live demos, safe previews, and client systems with honest status labels.</p>
    </div>
    <div>
      <span class="eyebrow">GitHub</span>
      <strong>Public proof</strong>
      <p>Selected repositories where public source makes the case stronger.</p>
    </div>
  </section>

  <section class="section container featured">
    <div class="section-head">
      <span class="eyebrow">Selected work</span>
      <h2>Sites and tools that prove the process.</h2>
    </div>
    <div class="featured-grid">
      {featured.map((item) => (
        <a class="work-card" href={item.href}>
          <span>{item.type}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <b>Open <Icon name="arrow-right" size={16} /></b>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) { background: var(--forest-950); }

  .hero {
    position: relative;
    min-height: min(720px, calc(88svh - 76px));
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-art,
  .hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-art {
    z-index: -3;
    background-image: url("/assets/concepts/coast-texas-seawall-dinero-rooster-right.png?v=1");
    background-position: center center;
    background-size: cover;
    transform: scale(1.01);
  }

  .hero-shade {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(6, 27, 20, 0.97), rgba(6, 27, 20, 0.68) 42%, rgba(6, 27, 20, 0.08) 78%),
      linear-gradient(180deg, rgba(6, 27, 20, 0.04), rgba(6, 27, 20, 0.84));
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  .hero-copy {
    max-width: 780px;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0.45rem 0 1rem;
    font-size: clamp(3.2rem, 7vw, 6.7rem);
    line-height: 0.88;
    letter-spacing: 0;
    text-shadow: 0 5px 24px rgba(2, 15, 10, 0.62);
  }

  .hero .lede {
    max-width: 620px;
    color: var(--cream);
    text-shadow: 0 3px 18px rgba(2, 15, 10, 0.74);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    padding-block: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--line);
  }

  .proof-strip > div {
    padding: 1.25rem;
    background: rgba(6, 27, 20, 0.82);
  }

  .proof-strip strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--step-1);
  }

  .proof-strip p,
  .work-card p {
    margin: 0;
    color: var(--cream-muted);
  }

  .featured {
    padding-top: var(--space-md);
  }

  .grader-widget {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(219, 110, 66, 0.12), transparent 48%),
      rgba(6, 27, 20, 0.66);
    box-shadow: var(--shadow-md);
    transform: translateY(-2rem);
  }

  .grader-copy h2 {
    max-width: 720px;
    margin-top: 0.4rem;
    letter-spacing: 0;
  }

  .grader-copy p {
    max-width: 660px;
    margin: 0;
    color: var(--cream-muted);
  }

  .grade-teaser {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid rgba(244, 238, 220, 0.24);
    border-radius: 18px;
    background: rgba(244, 238, 220, 0.045);
  }

  .cta-sign-stack {
    width: min(100%, 330px);
    position: relative;
    display: block;
    justify-self: center;
    margin-bottom: 1.35rem;
  }

  .cta-logo {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 16px 30px rgba(2, 15, 10, 0.32));
  }

  .grade-teaser label {
    color: var(--cream);
    font-size: var(--step-1);
    font-weight: 850;
    line-height: 1.15;
  }

  .teaser-row {
    display: grid;
    gap: 0.55rem;
  }

  .teaser-row input {
    min-height: 3.35rem;
    width: 100%;
    border: 1px solid rgba(244, 238, 220, 0.72);
    border-radius: 999px;
    padding-inline: 1rem;
    background: var(--cream);
    color: var(--forest-950);
    font: 850 1rem/1 var(--sans);
  }

  .teaser-row input::placeholder {
    color: rgba(6, 27, 20, 0.56);
  }

  .teaser-row .btn {
    justify-content: center;
    text-transform: uppercase;
  }

  .grader-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--cream-muted);
    font-weight: 850;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: var(--space-md);
  }

  .section-head h2 {
    letter-spacing: 0;
  }

  .featured-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  .work-card {
    min-height: 260px;
    flex: 1 1 230px;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(244, 238, 220, 0.06), rgba(6, 27, 20, 0.78)),
      rgba(11, 45, 34, 0.72);
  }

  .work-card span {
    color: var(--cream-muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-card h3 {
    margin: 0;
    letter-spacing: 0;
  }

  .work-card b {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--cream);
  }

  @media (max-width: 880px) {
    .hero-inner,
    .proof-strip,
    .featured-grid,
    .grader-widget {
      grid-template-columns: 1fr;
    }

    .featured-grid {
      flex-direction: column;
    }

    /* mobile: center everything */
    .hero-copy {
      text-align: center;
      margin-inline: auto;
    }

    .hero h1,
    .hero .lede {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .section-head,
    .section-head h2,
    .grader-copy {
      text-align: center;
      margin-inline: auto;
    }

    .proof-strip > div {
      text-align: center;
    }

    .work-card {
      max-width: none;
      text-align: left;
      align-items: stretch;
    }

    .hero {
      min-height: 560px;
      align-items: end;
    }

    .hero-art {
      background-position: 66% center;
      transform: none;
    }

    .hero-shade {
      background:
        linear-gradient(90deg, rgba(6, 27, 20, 0.98), rgba(6, 27, 20, 0.78) 54%, rgba(6, 27, 20, 0.2)),
        linear-gradient(180deg, rgba(6, 27, 20, 0.06), rgba(6, 27, 20, 0.88));
    }

    .hero-inner {
      padding-block: 3.6rem 3.2rem;
    }

    .hero h1 {
      max-width: 10ch;
      font-size: 3rem;
      line-height: 0.94;
    }

    .hero .lede {
      max-width: 31ch;
    }

    .proof-strip {
      transform: none;
      margin-top: var(--space-md);
    }

    .grader-widget {
      transform: none;
      margin-top: var(--space-md);
      padding: 1rem;
      gap: 1.25rem;
    }

    .grade-teaser {
      justify-items: center;
      text-align: center;
    }

    .cta-sign-stack {
      width: min(100%, 272px);
      margin-inline: auto;
      margin-bottom: 1.2rem;
    }

    .grade-teaser label,
    .teaser-row {
      width: 100%;
      text-align: left;
    }

    .grader-link {
      justify-self: center;
    }
  }

  @media (max-width: 460px) {
    .hero {
      min-height: 520px;
    }

    .hero-art {
      background-position: 71% center;
    }

    .hero h1 {
      font-size: 2.75rem;
    }

    .hero-actions .btn {
      padding-inline: 1.05rem;
    }

    .grader-widget {
      border-radius: 14px;
    }

    .grade-teaser {
      padding: 0.85rem;
      border-radius: 14px;
    }
  }
</style>
