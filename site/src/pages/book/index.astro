---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";

const chapters = [
  { n: 1, slug: "/book/chapter-one", title: "What is an agent?", blurb: "A helper that can look, think, and do — explained like you're eight. With a live agent you can poke.", status: "live" },
  { n: 2, slug: "#", title: "Tools: giving your agent hands", blurb: "How an agent uses tools to actually get things done.", status: "soon" },
  { n: 3, slug: "#", title: "Memory: how it remembers you", blurb: "Why your agent doesn't forget what you told it yesterday.", status: "soon" },
];
---

<BaseLayout title="Teach Agentic AI (like a kid) — Dinero Hwy" description="A plain-English, demo-first book that teaches how agentic AI works — one playable idea at a time.">
  <section class="section container book-hero">
    <span class="product-icon"><Icon name="book" size={30} /></span>
    <span class="eyebrow">Learn by playing</span>
    <h1>Agentic AI, explained like you're a kid.</h1>
    <p class="lede">Every idea comes with a live demo you can touch. No jargon, no math — just "here's the thing, now try it."</p>
    <div class="route-bar" aria-hidden="true"></div>
  </section>

  <section class="section container">
    <ol class="chapters">
      {chapters.map((c) => (
        <li>
          <a class:list={["chapter", c.status === "soon" && "is-soon"]} href={c.slug}>
            <span class="chapter-n">{String(c.n).padStart(2, "0")}</span>
            <span>
              <span class="chapter-title">{c.title}{c.status === "soon" && <em> — soon</em>}</span>
              <span class="chapter-blurb">{c.blurb}</span>
            </span>
            {c.status === "live" && <Icon name="arrow-right" size={20} />}
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .book-hero { display: grid; justify-items: start; gap: 0.75rem; max-width: 760px; }
  .product-icon { display: grid; place-items: center; width: 54px; height: 54px; border-radius: var(--radius-md); background: rgba(6,27,20,.5); border: 1px solid var(--line); color: var(--rust-light); }
  .chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .chapter {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.25rem;
    padding: 1.25rem 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(40,84,64,.2), rgba(6,27,20,.28));
  }
  .chapter:hover { border-color: var(--line-strong); color: var(--cream); transform: translateY(-2px); transition: .15s; }
  .chapter.is-soon { opacity: 0.6; }
  .chapter-n { font-family: var(--condensed); font-weight: 700; font-size: var(--step-3); color: var(--rust); }
  .chapter-title { display: block; font-weight: 800; font-size: var(--step-1); }
  .chapter-title em { color: var(--cream-muted); font-style: normal; font-weight: 700; }
  .chapter-blurb { display: block; color: var(--cream-muted); margin-top: 0.2rem; }
</style>
