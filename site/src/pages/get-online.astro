---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import Icon from "../components/Icon.astro";

// Scene captions (also used as the reduced-motion storyboard). Times are the
// duration each scene holds, in ms.
const scenes = [
  { d: 5000, cap: "Your customers are online — driving right past you." },
  { d: 5200, cap: "Great business. But online? You’re invisible." },
  { d: 5200, cap: "So we do it with you. Pick a name in minutes." },
  { d: 6200, cap: "Own your spot for about $12 a year — your digital real estate." },
  { d: 6200, cap: "We build it with the world’s most advanced AI — priced to fit your budget." },
  { d: 7200, cap: "You run the business. We build the internet part — and it grows while you work." },
];
---

<BaseLayout
  title="Get Online — $10/yr digital real estate | Dinero Hwy"
  description="Watch how easy it is to get your business online: pick a name, claim it on Cloudflare for about $10 a year, and we build the whole site. You don't touch a thing."
>
  <section class="go-hero container">
    <span class="eyebrow">Get online</span>
    <h1>$10 a year for digital real estate.</h1>
    <p class="lede">Being online should be simple. Watch how a name, ten bucks, and Dinero Hwy put your business on the map — you don't touch a keyboard.</p>
  </section>

  <section class="film-wrap">
    <div class="film" id="film" data-scene="0" role="img" aria-label="Animated explainer: getting your local business online for about ten dollars a year.">

      <!-- SCENE 1 — the dark stretch of highway -->
      <div class="scene scene-1">
        <div class="road" aria-hidden="true"></div>
        <div class="signs" aria-hidden="true">
          <span class="rsign lit"></span><span class="rsign lit"></span>
          <span class="rsign dark"><small>YOUR SHOP?</small></span>
          <span class="rsign lit"></span><span class="rsign lit"></span>
        </div>
        <div class="traffic" aria-hidden="true">
          <span class="car"></span><span class="car c2"></span><span class="car c3"></span>
          <span class="car c4"></span><span class="car c5"></span>
        </div>
      </div>

      <!-- SCENE 2 — the owner behind the counter -->
      <div class="scene scene-2">
        <div class="shop" aria-hidden="true">
          <div class="owner"><span class="head"></span><span class="apron"></span></div>
          <div class="counter"></div>
          <div class="bubble">"I don't do computers."</div>
        </div>
      </div>

      <!-- SCENE 3 — brainstorm the name on a napkin -->
      <div class="scene scene-3">
        <div class="napkin" aria-hidden="true">
          <span class="scratch s-a">carniceria?</span>
          <span class="scratch s-b">cruz-meats?</span>
          <span class="pick">cruzmeats.com <b class="chk"><Icon name="check" size={26} /></b></span>
        </div>
      </div>

      <!-- SCENE 4 — mint the sign + $10 tag -->
      <div class="scene scene-4">
        <div class="mint" aria-hidden="true">
          <span class="supra">DIGITAL REAL ESTATE</span>
          <img class="signlogo" src="/assets/dinerohwy-logo-primary.svg" alt="" width="590" height="270" />
          <span class="tag"><b>$12</b><span>/yr</span><small>your land · Cloudflare</small></span>
        </div>
      </div>

      <!-- SCENE 5 — we build the site (priced to fit) -->
      <div class="scene scene-5">
        <div class="build-wrap" aria-hidden="true">
          <div class="browser">
            <div class="chrome"><i></i><i></i><i></i><span>cruzmeats.com</span></div>
            <div class="build">
              <span class="blk b1"></span><span class="blk b2"></span>
              <span class="blk b3"></span><span class="blk b4"></span><span class="blk b5"></span>
            </div>
          </div>
          <div class="pricefit">
            <span class="ai-strip"><span class="ai-label">Powered by</span><span class="ai-chip">Claude</span><span class="ai-dot">·</span><span class="ai-chip">ChatGPT</span><span class="ai-dot">·</span><span class="ai-chip">Grok</span></span>
            <span class="pf-label">Built by Dinero Hwy · <b>priced to fit</b></span>
            <span class="pf-range"><i>Simple site</i><span class="pf-bar"><b></b></span><i>Full storefront</i></span>
          </div>
        </div>
      </div>

      <!-- SCENE 6 — payoff + CTA -->
      <div class="scene scene-6">
        <div class="road payoff" aria-hidden="true"></div>
        <div class="traffic exit" aria-hidden="true"><span class="car"></span><span class="car c2"></span><span class="car c3"></span></div>
        <svg class="growthline" viewBox="0 0 200 120" aria-hidden="true" preserveAspectRatio="none">
          <polyline class="gl-line" points="8,108 52,86 96,90 140,44 190,12" />
          <path class="gl-arrow" d="M172 12 L190 12 L190 30" />
        </svg>
        <div class="endcard">
          <img src="/assets/dinerohwy-logo-primary.svg" alt="Dinero Hwy" width="590" height="270" />
          <p class="kicker">You built the business.<br />We build the internet part.<br /><b>You collect the dinero.</b></p>
          <p class="reassure">$12/yr for your land. The site? We build it — <b>priced to fit</b>.</p>
          <p class="ai-credit">Built with Claude, ChatGPT &amp; Grok — and a human you can meet.</p>
          <p class="url">See your sign first — free · <b>dinerohwy.com</b></p>
          <p class="cf"><Icon name="cloud" size={15} /> Domain &amp; hosting on Cloudflare</p>
        </div>
      </div>

      <!-- captions + progress -->
      <p class="caption" id="caption" aria-live="polite"></p>
      <div class="superline" id="superline">Invest twelve bucks a year in digital real estate. Watch it grow.</div>
      <div class="progress" aria-hidden="true"><span id="bar"></span></div>
      <button class="film-start" id="filmStart" type="button">
        <Icon name="arrow-right" size={20} /> Play the ad
      </button>
    </div>

    <div class="controls">
      <button class="btn btn-ghost" id="replay" type="button" hidden>↻ Replay</button>
      <a class="btn btn-primary" href="/free">Get your sign — free Report Card <Icon name="arrow-right" size={16} /></a>
    </div>

    <!-- reduced-motion / no-JS storyboard -->
    <ol class="storyboard" id="storyboard" hidden>
      {scenes.map((s, i) => (
        <li><span class="sb-n">{i + 1}</span><span>{s.cap}</span></li>
      ))}
      <li class="sb-super"><span class="sb-n">★</span><span>Ten bucks a year for digital real estate. That's a no-brainer.</span></li>
    </ol>
  </section>

  <section class="section container go-cost">
    <div class="card">
      <h2>The math is almost silly.</h2>
      <div class="compare">
        <div class="col"><span class="big">$2,000<small>/mo</small></span><span class="lbl">A storefront on Main Street</span></div>
        <div class="vs">vs</div>
        <div class="col win"><span class="big">$10<small>/yr</small></span><span class="lbl">A storefront on the internet</span></div>
      </div>
      <p class="lede" style="margin-top:1.5rem">Same idea — a place customers can find you — for about the cost of one lunch, once a year. We handle the tech; you keep doing what you're good at.</p>
      <EmailCapture variant="inline" magnet="get-online" source="get-online" heading="" sub="" collectBusiness={true} buttonLabel="Show me my free Report Card" />
    </div>
  </section>
</BaseLayout>

<script define:vars={{ scenes }}>
  const film = document.getElementById("film");
  const caption = document.getElementById("caption");
  const bar = document.getElementById("bar");
  const startBtn = document.getElementById("filmStart");
  const replay = document.getElementById("replay");
  const storyboard = document.getElementById("storyboard");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const total = scenes.reduce((a, s) => a + s.d, 0);
  let timers = [];
  const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

  function play() {
    clearTimers();
    startBtn.hidden = true;
    replay.hidden = true;
    bar.style.transition = "none";
    bar.style.width = "0%";
    // force reflow so the width reset applies before we animate
    void bar.offsetWidth;
    bar.style.transition = `width ${total}ms linear`;
    bar.style.width = "100%";

    let acc = 0;
    scenes.forEach((s, i) => {
      timers.push(setTimeout(() => {
        film.dataset.scene = String(i + 1);
        caption.textContent = s.cap;
      }, acc));
      acc += s.d;
    });
    timers.push(setTimeout(() => {
      film.dataset.scene = "6";      // hold end card
      film.classList.add("is-done");
      replay.hidden = false;
    }, total));
  }

  if (reduce) {
    // Static storyboard: show the end card + the full script, no motion.
    film.dataset.scene = "6";
    caption.textContent = scenes[scenes.length - 1].cap;
    startBtn.hidden = true;
    storyboard.hidden = false;
  } else {
    startBtn.addEventListener("click", play);
    replay.addEventListener("click", () => { film.classList.remove("is-done"); play(); });
    // Auto-play once when it scrolls into view.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { io.disconnect(); play(); }
      });
    }, { threshold: 0.5 });
    io.observe(film);
  }
</script>

<style>
  .go-hero { max-width: 780px; padding-top: var(--space-2xl); }
  .go-hero h1 { margin: .3rem 0; }

  .film-wrap { width: min(1000px, calc(100% - 2rem)); margin: var(--space-lg) auto 0; }

  .film {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(120% 80% at 50% -10%, #0c3325, transparent 60%),
      linear-gradient(180deg, #05130e 0%, #061b14 55%, #030d09 100%),
      #05130e;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  /* scenes cross-fade; only the active one shows */
  .scene {
    position: absolute; inset: 0;
    opacity: 0; visibility: hidden;
    transition: opacity .4s ease, visibility .4s;
    display: grid; place-items: center;
  }
  .film[data-scene="1"] .scene-1,
  .film[data-scene="2"] .scene-2,
  .film[data-scene="3"] .scene-3,
  .film[data-scene="4"] .scene-4,
  .film[data-scene="5"] .scene-5,
  .film[data-scene="6"] .scene-6 { opacity: 1; visibility: visible; }

  /* ---------- shared road ---------- */
  .road {
    position: absolute; left: 0; right: 0; bottom: 0; height: 42%;
    background: linear-gradient(180deg, #0a2a20, #06180f);
    border-top: 2px solid rgba(244,238,220,.14);
  }
  .road::after {
    content: ""; position: absolute; top: 46%; left: 0; right: 0; height: 4px;
    background: repeating-linear-gradient(90deg, var(--rust) 0 34px, transparent 34px 74px);
    opacity: .8;
  }
  .film[data-scene="1"] .scene-1 .road::after { animation: dash 1.1s linear infinite; }
  .film[data-scene="6"] .scene-6 .road::after { animation: dash 1.1s linear infinite; }
  @keyframes dash { to { background-position: -108px 0; } }

  /* roadside signs */
  .signs { position: absolute; top: 16%; left: 0; right: 0; display: flex; justify-content: center; gap: clamp(10px, 3vw, 34px); }
  .rsign { width: clamp(48px, 9vw, 96px); height: clamp(34px, 6.5vw, 66px); border-radius: 8px; border: 3px solid rgba(244,238,220,.5);
    background: linear-gradient(160deg, #1b4635, #103326); position: relative; display: grid; place-items: center; }
  .rsign.lit { box-shadow: 0 0 22px rgba(219,110,66,.5), inset 0 0 0 2px rgba(244,238,220,.3); border-color: var(--cream); }
  .rsign.lit::before { content: ""; width: 60%; height: 44%; border-radius: 3px; background: var(--cream); opacity: .85; }
  .rsign.dark { opacity: .5; border-color: rgba(244,238,220,.28); }
  .rsign.dark small { font-size: clamp(7px, 1.4vw, 11px); font-weight: 800; letter-spacing: .06em; color: var(--cream-muted); }
  .film[data-scene="1"] .scene-1 .rsign.dark { animation: worry 1.4s ease-in-out infinite; }
  @keyframes worry { 50% { opacity: .28; } }

  /* traffic streaks */
  .traffic { position: absolute; left: 0; right: 0; bottom: 15%; height: 40px; }
  .car { position: absolute; top: 0; width: 34px; height: 12px; border-radius: 6px;
    background: linear-gradient(90deg, #7a1f10, var(--rust)); box-shadow: 0 0 12px rgba(219,110,66,.7); }
  .film[data-scene="1"] .scene-1 .car,
  .film[data-scene="6"] .scene-6 .car { animation: drive 2.6s linear infinite; }
  .car.c2 { top: 16px; animation-duration: 3.4s !important; animation-delay: -1s !important; opacity: .9; }
  .car.c3 { top: 6px; animation-duration: 2.1s !important; animation-delay: -1.6s !important; }
  .car.c4 { top: 20px; animation-duration: 3s !important; animation-delay: -.5s !important; opacity: .8; }
  .car.c5 { top: 10px; animation-duration: 2.4s !important; animation-delay: -2s !important; }
  @keyframes drive { from { left: -12%; } to { left: 112%; } }
  /* cars peel to the exit in the payoff */
  .traffic.exit .car { animation: peel 2.4s ease-in infinite !important; }
  @keyframes peel { 0% { left: -10%; top: 0; opacity: 1; } 70% { top: 0; } 100% { left: 60%; top: -120px; opacity: 0; } }

  /* ---------- scene 2 : shop ---------- */
  .shop { position: relative; width: 70%; height: 70%; }
  .counter { position: absolute; left: 8%; right: 8%; bottom: 12%; height: 26%; border-radius: 10px;
    background: linear-gradient(180deg, #285440, #103326); border: 2px solid rgba(244,238,220,.25); }
  .owner { position: absolute; left: 50%; bottom: 34%; transform: translateX(-50%); display: grid; justify-items: center; }
  .head { width: clamp(40px, 8vw, 64px); aspect-ratio: 1; border-radius: 50%; background: #d8b48c; border: 3px solid #b98e63; }
  .apron { width: clamp(80px, 16vw, 130px); height: clamp(70px, 13vw, 110px); margin-top: -6px; border-radius: 20px 20px 8px 8px; background: linear-gradient(180deg, var(--cream), var(--cream-muted)); border: 2px solid #b7b09a; }
  .bubble { position: absolute; top: 4%; right: 4%; max-width: 46%; padding: .8rem 1rem; border-radius: 14px 14px 14px 2px;
    background: var(--cream); color: #103326; font-weight: 800; font-size: clamp(13px, 2.4vw, 20px); box-shadow: var(--shadow-sm); }
  .film[data-scene="2"] .scene-2 .bubble { animation: pop .5s cubic-bezier(.2,.9,.3,1.3) both; }
  @keyframes pop { from { opacity: 0; transform: scale(.6) translateY(8px); } }

  /* ---------- scene 3 : napkin ---------- */
  .napkin { position: relative; width: min(64%, 460px); aspect-ratio: 3/2; background: #fbf7ea; border-radius: 8px;
    transform: rotate(-3deg); box-shadow: var(--shadow-md); color: #14352a; display: grid; align-content: center; gap: .5rem; padding: 8%; font-weight: 700; }
  .scratch { font-size: clamp(15px, 3vw, 26px); color: #6f7b63; text-decoration: line-through; opacity: 0; }
  .film[data-scene="3"] .scene-3 .s-a { animation: fadeUp .35s .15s both; }
  .film[data-scene="3"] .scene-3 .s-b { animation: fadeUp .35s .6s both; }
  .pick { font-size: clamp(20px, 4.4vw, 40px); font-weight: 900; color: #10361f; display: flex; align-items: center; gap: .5rem; opacity: 0; }
  .film[data-scene="3"] .scene-3 .pick { animation: fadeUp .4s 1.1s both; }
  .chk { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--rust); color: var(--cream); }
  .film[data-scene="3"] .scene-3 .chk { animation: pop .35s 1.5s both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* ---------- scene 4 : mint the sign + tag ---------- */
  .mint { position: relative; display: grid; justify-items: center; gap: 1rem; width: 80%; }
  .supra { font-family: var(--mono); font-size: clamp(11px, 2vw, 16px); letter-spacing: .28em; color: var(--rust-light); font-weight: 800; opacity: 0; }
  .film[data-scene="4"] .scene-4 .supra { animation: fadeUp .5s .1s both; }
  .signlogo { width: min(70%, 460px); height: auto; filter: drop-shadow(0 18px 26px rgba(2,15,10,.5)); opacity: 0; }
  .film[data-scene="4"] .scene-4 .signlogo { animation: plant .6s .25s cubic-bezier(.2,.9,.3,1.2) both; }
  @keyframes plant { from { opacity: 0; transform: translateY(-26px) scale(.9); } to { opacity: 1; transform: none; } }
  .tag { position: absolute; top: 6%; right: 2%; transform-origin: top center; display: grid; justify-items: center; padding: .5rem .9rem;
    background: linear-gradient(160deg, var(--rust-light), var(--rust-deep)); border-radius: 10px; color: var(--cream); box-shadow: var(--shadow-md); opacity: 0; }
  .tag::before { content: ""; position: absolute; top: -14px; width: 2px; height: 14px; background: rgba(244,238,220,.6); }
  .tag b { font-size: clamp(22px, 5vw, 44px); font-weight: 900; line-height: 1; }
  .tag span { font-weight: 800; }
  .tag small { font-size: 10px; letter-spacing: .08em; opacity: .9; }
  .film[data-scene="4"] .scene-4 .tag { animation: swingIn .7s .5s cubic-bezier(.2,.9,.3,1.2) both; }
  @keyframes swingIn { 0% { opacity: 0; transform: rotate(-24deg) translateY(-10px); } 60% { opacity: 1; transform: rotate(10deg); } 100% { transform: rotate(0); opacity: 1; } }

  /* ---------- scene 5 : build the site ---------- */
  .browser { width: min(74%, 520px); border-radius: 12px; overflow: hidden; border: 1px solid var(--line-strong); background: var(--forest-900); box-shadow: var(--shadow-md); }
  .chrome { display: flex; align-items: center; gap: 6px; padding: .5rem .75rem; background: var(--forest-800); }
  .chrome i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .chrome span { margin-left: .5rem; font-size: 12px; color: var(--cream-muted); font-family: var(--mono); }
  .build { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 16px; min-height: 190px; }
  .blk { border-radius: 8px; background: linear-gradient(160deg, rgba(40,84,64,.6), rgba(6,27,20,.5)); border: 1px solid var(--line); opacity: 0; }
  .blk.b1 { grid-column: 1 / -1; height: 46px; background: linear-gradient(90deg, var(--rust-deep), var(--rust)); }
  .blk.b2, .blk.b3 { height: 56px; }
  .blk.b4, .blk.b5 { height: 40px; }
  .film[data-scene="5"] .scene-5 .blk { animation: blockIn .42s both; }
  .film[data-scene="5"] .scene-5 .b1 { animation-delay: .15s; }
  .film[data-scene="5"] .scene-5 .b2 { animation-delay: .45s; }
  .film[data-scene="5"] .scene-5 .b3 { animation-delay: .65s; }
  .film[data-scene="5"] .scene-5 .b4 { animation-delay: .85s; }
  .film[data-scene="5"] .scene-5 .b5 { animation-delay: 1s; }
  @keyframes blockIn { from { opacity: 0; transform: translateY(14px) scale(.96); } to { opacity: 1; transform: none; } }

  /* scene 5 — priced-to-fit range */
  .build-wrap { display: grid; gap: 1rem; justify-items: center; width: min(74%, 520px); }
  .pricefit { display: grid; gap: .5rem; justify-items: center; width: 100%; opacity: 0; }
  .film[data-scene="5"] .scene-5 .pricefit { animation: fadeUp .5s 1.15s both; }
  .ai-strip { display: inline-flex; align-items: center; gap: .45rem; font-family: var(--mono); }
  .ai-label { font-size: clamp(9px, 1.5vw, 12px); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--cream-muted); }
  .ai-chip { padding: .2rem .6rem; border: 1px solid var(--line-strong); border-radius: 999px; background: rgba(6,27,20,.5); color: var(--cream); font-weight: 700; font-size: clamp(10px, 1.8vw, 14px); }
  .ai-dot { color: var(--rust); font-weight: 800; }
  .pf-label { font-size: clamp(11px, 1.9vw, 15px); color: var(--cream-muted); letter-spacing: .02em; }
  .pf-label b { color: var(--cream); }
  .pf-range { display: flex; align-items: center; gap: .6rem; width: 100%; }
  .pf-range i { font-style: normal; font-size: clamp(9px, 1.5vw, 12px); color: var(--cream-muted); white-space: nowrap; }
  .pf-bar { position: relative; flex: 1; height: 5px; border-radius: 999px; background: linear-gradient(90deg, rgba(219,110,66,.35), var(--rust)); }
  .pf-bar b { position: absolute; top: 50%; left: 42%; width: 13px; height: 13px; border-radius: 50%; background: var(--cream); border: 2px solid var(--rust); transform: translate(-50%,-50%); }

  /* ---------- scene 6 : end card ---------- */
  .growthline { position: absolute; top: 8%; right: 6%; width: 22%; max-width: 200px; height: auto; z-index: 1; opacity: .85; }
  .growthline .gl-line, .growthline .gl-arrow { fill: none; stroke: var(--rust-light); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .growthline .gl-line { stroke-dasharray: 320; stroke-dashoffset: 320; }
  .growthline .gl-arrow { stroke-dasharray: 60; stroke-dashoffset: 60; }
  .film[data-scene="6"] .scene-6 .growthline .gl-line { animation: draw 1s .5s ease-out forwards; }
  .film[data-scene="6"] .scene-6 .growthline .gl-arrow { animation: draw 0.4s 1.4s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (max-width: 620px) { .growthline { display: none; } }

  .endcard { position: relative; z-index: 2; display: grid; justify-items: center; gap: .5rem; text-align: center; padding: 1rem; }
  .endcard img { width: min(48%, 300px); height: auto; filter: drop-shadow(0 16px 22px rgba(2,15,10,.5)); }
  .film[data-scene="6"] .scene-6 .endcard img { animation: plant .6s both; }
  .kicker { font-size: clamp(15px, 2.8vw, 24px); font-weight: 800; line-height: 1.25; margin: .4rem 0 0; }
  .kicker b { color: var(--rust-light); }
  .reassure { font-size: clamp(12px, 2vw, 16px); color: var(--cream); margin: .6rem 0 0; font-weight: 700; }
  .reassure b { color: var(--rust-light); }
  .ai-credit { font-family: var(--mono); font-size: clamp(10px, 1.7vw, 13px); color: var(--cream-muted); margin: .35rem 0 0; letter-spacing: .02em; }
  .url { font-size: clamp(12px, 2vw, 16px); color: var(--cream-muted); margin: .3rem 0 0; }
  .url b { color: var(--cream); }
  .cf { display: inline-flex; align-items: center; gap: .4rem; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--cream-muted); margin: .2rem 0 0; }
  .cf :global(svg) { color: var(--rust-light); }

  /* ---------- captions / super / progress / start ---------- */
  .caption {
    position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%);
    width: min(90%, 760px); margin: 0; text-align: center;
    font-size: clamp(15px, 2.9vw, 26px); font-weight: 800; line-height: 1.25; letter-spacing: -.01em;
    color: var(--cream); text-shadow: 0 2px 10px rgba(2,15,10,.9), 0 0 3px rgba(2,15,10,.8);
  }
  .superline {
    position: absolute; left: 0; right: 0; bottom: 8%; text-align: center;
