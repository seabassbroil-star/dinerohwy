---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const initialUrl = Astro.url.searchParams.get("url") ?? "";
---

<BaseLayout
  title="Website Report Card - DineroHWY"
  description="Run a quick website grade for a local business site and see the highest-value fixes."
>
  <section class="report-shell container">
    <div class="report-copy">
      <span class="eyebrow">Website Report Card</span>
      <h1>Grade a site before the pitch.</h1>
      <p class="lede">
        This is the customer-facing tool: enter a business URL and get a practical
        score with the fixes that matter first.
      </p>
    </div>

    <form id="report-form" class="report-form">
      <label>
        <span>Website</span>
        <input name="url" type="text" value={initialUrl} placeholder="yourbusiness.com" autocomplete="url" required />
      </label>
      <label>
        <span>Business name</span>
        <input name="business" type="text" placeholder="Optional" autocomplete="organization" />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" placeholder="Optional for follow-up" autocomplete="email" />
      </label>
      <button class="btn btn-primary" type="submit">
        Run Grade <Icon name="arrow-right" size={17} />
      </button>
      <p id="report-message" class="form-note" role="status"></p>
    </form>
  </section>

  <section class="section container result-wrap" aria-live="polite">
    <article id="empty-result" class="empty-state">
      <Icon name="seo" size={30} />
      <div>
        <h2>What the grader checks</h2>
        <p>HTTPS, phone usability, mobile setup, titles, descriptions, local signals, images, social previews, favicon, and load weight.</p>
      </div>
    </article>

    <article id="report-result" class="result" hidden>
      <div class="score-card">
        <span id="grade">—</span>
        <b id="score">0/100</b>
      </div>
      <div class="result-copy">
        <span class="eyebrow">Audit Result</span>
        <h2 id="headline"></h2>
        <p id="summary"></p>
        <div id="fixes" class="fixes"></div>
      </div>
    </article>

    <div id="checks" class="checks" hidden></div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("#report-form");
  const message = document.querySelector("#report-message");
  const result = document.querySelector("#report-result");
  const empty = document.querySelector("#empty-result");
  const checks = document.querySelector("#checks");
  const grade = document.querySelector("#grade");
  const score = document.querySelector("#score");
  const headline = document.querySelector("#headline");
  const summary = document.querySelector("#summary");
  const fixes = document.querySelector("#fixes");

  function escapeHtml(value) {
    const div = document.createElement("div");
    div.textContent = String(value ?? "");
    return div.innerHTML;
  }

  function statusClass(status) {
    return status === "pass" ? "pass" : status === "fail" ? "fail" : "warn";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);

    if (message) message.textContent = "Running the audit...";
    form.querySelector("button")?.setAttribute("disabled", "true");

    try {
      const response = await fetch("/api/report", { method: "POST", body: data });
      const payload = await response.json();
      if (!response.ok || !payload.ok) throw new Error(payload.message || "Could not run the report.");

      const report = payload.report;
      if (empty) empty.hidden = true;
      if (result) result.hidden = false;
      if (checks) checks.hidden = false;
      if (grade) grade.textContent = report.grade;
      if (score) score.textContent = `${report.score}/100`;
      if (headline) headline.textContent = report.headline;
      if (summary) summary.textContent = report.summary;

      if (fixes) {
        fixes.innerHTML = report.fixes.map((fix) => `
          <div class="fix">
            <strong>${escapeHtml(fix.title)}</strong>
            <p>${escapeHtml(fix.why)}</p>
          </div>
        `).join("");
      }

      if (checks) {
        checks.innerHTML = report.checks.map((check) => `
          <article class="check ${statusClass(check.status)}">
            <span>${escapeHtml(check.status)}</span>
            <strong>${escapeHtml(check.label)}</strong>
            <p>${escapeHtml(check.detail)}</p>
          </article>
        `).join("");
      }

      if (message) message.textContent = report.reachable ? "Report complete." : "No reachable site found, but the opportunity is clear.";
    } catch (error) {
      if (message) message.textContent = error instanceof Error ? error.message : "Could not run the report.";
    } finally {
      form.querySelector("button")?.removeAttribute("disabled");
    }
  });
</script>

<style>
  .report-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
    padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg);
  }

  .report-copy h1 {
    max-width: 760px;
    margin-top: 0.45rem;
    letter-spacing: 0;
  }

  .report-copy .lede {
    color: var(--cream-muted);
  }

  .report-form {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: rgba(6, 27, 20, 0.68);
    box-shadow: var(--shadow-md);
  }

  .report-form label {
    display: grid;
    gap: 0.35rem;
  }

  .report-form label span {
    color: var(--cream-muted);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .report-form input {
    min-height: 3.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding-inline: 1rem;
    background: var(--cream);
    color: var(--forest-950);
    font: 850 1rem/1 var(--sans);
  }

  .report-form button {
    justify-content: center;
    border: 0;
  }

  .form-note {
    min-height: 1.5rem;
    margin: 0;
    color: var(--cream-muted);
    font-size: 0.9rem;
  }

  .result-wrap {
    padding-top: 0;
  }

  .empty-state,
  .result {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: clamp(1.2rem, 3vw, 2rem);
    background: rgba(6, 27, 20, 0.52);
  }

  .empty-state svg {
    color: var(--rust-light);
  }

  .empty-state h2,
  .result h2 {
    letter-spacing: 0;
  }

  .empty-state p,
  .result p {
    color: var(--cream-muted);
  }

  .score-card {
    min-width: 150px;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: linear-gradient(145deg, var(--rust-light), var(--rust-deep));
    box-shadow: var(--shadow-raised);
  }

  .score-card span {
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 0.9;
    font-weight: 900;
  }

  .score-card b {
    font-family: var(--mono);
  }

  .fixes {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .fix,
  .check {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.9rem;
    background: rgba(244, 238, 220, 0.045);
  }

  .fix p,
  .check p {
    margin: 0.25rem 0 0;
  }

  .checks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
    margin-top: var(--space-md);
  }

  .check span {
    display: inline-block;
    margin-bottom: 0.45rem;
    border-radius: 999px;
    padding: 0.22rem 0.48rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .check.pass span { background: rgba(94, 171, 116, 0.24); color: #b8ffc8; }
  .check.warn span { background: rgba(229, 169, 74, 0.22); color: #ffd98d; }
  .check.fail span { background: rgba(219, 110, 66, 0.24); color: #ffb49a; }

  @media (max-width: 880px) {
    .report-shell,
    .checks {
      grid-template-columns: 1fr;
    }

    .empty-state,
    .result {
      grid-template-columns: 1fr;
    }
  }
</style>
