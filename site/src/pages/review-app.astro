---
import ProductLayout from "../layouts/ProductLayout.astro";
import DemoFrame from "../components/DemoFrame.astro";
import Icon from "../components/Icon.astro";
import ReviewApp from "../demos/ReviewApp/ReviewApp.tsx";

const steps = [
  { icon: "upload", title: "Screenshot it", body: "See your site live on your phone and screenshot whatever feels off." },
  { icon: "pin", title: "Drop notes", body: "Tap the image to pin exactly what to change, and how urgent it is." },
  { icon: "code", title: "Ship the fix", body: "Export a tidy checklist or GitHub issue — the fix goes live, you re-check on your phone." },
];
---

<ProductLayout
  title="Review App"
  eyebrow="The mobile cockpit"
  icon="review"
  tagline="See your site live on your phone, screenshot it, drop notes right on the image, and ship the fix. This is the exact tool we use to build and refine every Dinero Hwy site."
  description="Screenshot, annotate, and turn notes into fixes — the Dinero Hwy review cockpit. Try it live."
  magnet="review-waitlist"
>
  <section>
    <h2>The loop</h2>
    <div class="loop-grid">
      {steps.map((s, i) => (
        <div class="loop-card">
          <span class="loop-num">{i + 1}</span>
          <span class="loop-icon"><Icon name={s.icon} size={20} /></span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Try it right now</h2>
    <p class="lede">Upload any screenshot, tap to drop numbered notes, then export a Markdown checklist or a GitHub-issue payload. This is the real tool — nothing leaves your browser.</p>
    <DemoFrame title="Review App" status="live" caption="100% in-browser. Export to Markdown or a GitHub issue and drop it straight into your workflow.">
      <ReviewApp client:visible />
    </DemoFrame>
  </section>
</ProductLayout>

<style>
  .loop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-top: var(--space-md); }
  .loop-card { position: relative; padding: 1.5rem 1.25rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgba(6,27,20,.3); }
  .loop-num { position: absolute; top: -14px; left: 1.25rem; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--rust); color: var(--cream); font-weight: 800; font-size: 14px; }
  .loop-icon { display: inline-flex; color: var(--rust-light); margin-bottom: 0.5rem; }
  .loop-card h3 { font-size: var(--step-1); margin-bottom: 0.35rem; }
  .loop-card p { color: var(--cream-muted); margin: 0; }
  @media (max-width: 760px) { .loop-grid { grid-template-columns: 1fr; } }
</style>
