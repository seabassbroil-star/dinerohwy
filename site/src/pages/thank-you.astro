---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank you - DineroHWY" description="Your DineroHWY Report Card is on the way." noindex={true}>
  <section class="section container ty">
    <span class="eyebrow">next exit confirmed</span>
    <h1>Check your inbox.</h1>
    <p class="lede">
      Your free Website &amp; Google Report Card is on the way. We will send the grade,
      the first three fixes, and what to do next.
    </p>
    <a class="btn btn-primary" href="/">Back to DineroHWY</a>
  </section>
</BaseLayout>

<style>
  .ty {
    min-height: calc(100svh - 154px);
    max-width: 680px;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .ty h1 {
    font-size: clamp(3rem, 8vw, 6.5rem);
    letter-spacing: 0;
  }

  .ty .lede {
    margin-bottom: 0.65rem;
  }
</style>
