---
import ProductLayout from "../layouts/ProductLayout.astro";
import DemoFrame from "../components/DemoFrame.astro";
---

<ProductLayout
  title="Intel Assistant"
  eyebrow="Your business, on call 24/7"
  icon="intel"
  tagline="An AI that actually knows your hours, prices, and services — answering customers and capturing their details around the clock, even when you're asleep."
  description="An AI assistant trained on your business that answers customers and captures leads 24/7."
  magnet="intel-waitlist"
>
  <section>
    <h2>The flagship demo</h2>
    <p class="lede">This is the tool you'll talk to right here on the site — ask it anything about Dinero Hwy and watch it answer, then naturally capture your email in the conversation.</p>
    <DemoFrame title="Intel Assistant" status="coming-soon" caption="The live chat widget is wiring up to its Cloudflare Worker backend.">
      <div style="min-height:240px"></div>
    </DemoFrame>
  </section>
</ProductLayout>
