---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { localizedPath } from "../../i18n/ui";
---

<BaseLayout title="Work & Case Studies — Dinero Hwy" description="Real projects, real outcomes. Selected work and case studies from Dinero Hwy.">
  <section class="section container" style="max-width:820px">
    <span class="eyebrow">Proof, not promises</span>
    <h1>The work.</h1>
    <p class="lede">Selected builds and case studies — each with the business outcome up front and the running site (or the code) a click away.</p>

    <div class="case-list">
      <a class="case card" href={localizedPath("/xavier", "es")}>
        <div class="case-flag">🇪🇸 Español</div>
        <h2>Xavier — first case study</h2>
        <p>How a local operator got online and started capturing leads. Told in Spanish, our first published case study.</p>
        <span class="case-link"><Icon name="arrow-right" size={18} /> Leer el caso</span>
      </a>
      <div class="case card is-empty">
        <h2>More landing soon</h2>
        <p>As client projects ship, before/after case studies with real numbers land here.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-list { margin-top: var(--space-lg); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .case { display: grid; gap: 0.5rem; align-content: start; }
  .case:hover { border-color: var(--line-strong); color: var(--cream); }
  .case-flag { font-weight: 800; font-size: var(--step--1); color: var(--cream-muted); }
  .case-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--rust-light); font-weight: 800; margin-top: 0.5rem; }
  .is-empty { opacity: 0.6; }
  @media (max-width: 700px) { .case-list { grid-template-columns: 1fr; } }
</style>
