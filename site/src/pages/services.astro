---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { servicePortfolio, toolsForService } from "../data/portfolio";
---

<BaseLayout title="Services - Dinero Hwy" description="Websites, ordering, quote intake, visibility, and business automation configured around local owners and their real workflows.">
  <section class="svc-hero container">
    <span class="eyebrow">Dinero Hwy services</span>
    <h1>Start with useful digital real estate. Add the machine when it earns its place.</h1>
    <p class="lede">A live site with hours and an about section is a smaller build than a shopping cart, ordering queue, or owner dashboard. The domain is roughly $12 a year; the build is quoted separately after we understand what the customer expects.</p>
    <div class="svc-cta">
      <button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">Talk through the business <Icon name="arrow-right" size={17} /></button>
      <a class="btn btn-ghost" href="/report-card">Grade an existing site</a>
    </div>
  </section>

  <section class="section container svc-grid" aria-label="Dinero Hwy services">
    {servicePortfolio.map((service) => {
      const tools = toolsForService(service);
      return (
        <article class="svc-card">
          <div class="svc-top"><Icon name={service.icon} size={23} /><span>{tools.length} supporting {tools.length === 1 ? "tool" : "tools"}</span></div>
          <h2>{service.name}</h2><strong>{service.promise}</strong><p>{service.description}</p>
          <div class="tool-list" aria-label={`Tools supporting ${service.name}`}>{tools.map((tool) => <span>{tool.name}</span>)}</div>
          <a href={service.path}>See how it works <Icon name="arrow-right" size={15} /></a>
        </article>
      );
    })}
  </section>

  <section class="section container svc-close">
    <span class="eyebrow">Not sure where to start?</span><h2>Show us the business, not a feature checklist.</h2>
    <p>We will separate what the owner needs now from what can wait. That keeps a basic site affordable and gives ordering, quoting, or automation the attention it deserves when it is truly part of the job.</p>
    <button type="button" class="btn btn-primary" data-textme-open aria-haspopup="dialog">Contact Dinero Hwy <Icon name="arrow-right" size={17} /></button>
  </section>
</BaseLayout>

<style>
  .svc-hero { padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg); }
  .svc-hero h1 { max-width: 940px; margin-top: 0.45rem; letter-spacing: 0; }
  .svc-hero .lede { max-width: 760px; color: var(--cream-muted); }
  .svc-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-md); }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr)); gap: var(--space-md); padding-top: 0; }
  .svc-card { display: grid; align-content: start; gap: 0.65rem; padding: clamp(1.2rem, 3vw, 1.7rem); border: 1px solid var(--line); border-radius: 18px; background: rgba(6, 27, 20, 0.6); }
  .svc-top { display: flex; align-items: center; justify-content: space-between; color: var(--rust-light); }
  .svc-top span { color: var(--cream-dim); font: 800 0.68rem/1.4 var(--mono); text-transform: uppercase; }
  .svc-card h2 { margin: 0.2rem 0 0; font-size: var(--step-2); letter-spacing: 0; }
  .svc-card strong { color: var(--cream); }
  .svc-card p { margin: 0; color: var(--cream-muted); }
  .tool-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.25rem; }
  .tool-list span { border: 1px solid var(--line); border-radius: 999px; padding: 0.25rem 0.48rem; color: var(--cream-muted); font: 750 0.66rem/1.3 var(--mono); }
  .svc-card a { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; font-weight: 850; }
  .svc-close { max-width: 820px; padding-top: var(--space-md); text-align: center; }
  .svc-close h2 { margin-top: 0.4rem; letter-spacing: 0; }
  .svc-close p { max-width: 680px; margin-inline: auto; color: var(--cream-muted); }
</style>
