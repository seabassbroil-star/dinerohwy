---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { toolsByStatus, type ToolDefinition, type ToolStatus } from "../data/portfolio";

const groups: Array<{ status: ToolStatus; eyebrow: string; title: string; intro: string }> = [
  { status: "Live", eyebrow: "Use now", title: "Working Dinero Hwy tools", intro: "These tools have a live customer-facing path on this site." },
  { status: "Preview", eyebrow: "Featured previews", title: "See the workflow before commissioning the build", intro: "Markup and Menu Builder demonstrate the experience while keeping private data and real transactions out of the public showcase." },
  { status: "Service", eyebrow: "Built for a client", title: "Tools configured around the business", intro: "These systems begin with a conversation about the owner's customers, operation, and expectations." },
  { status: "Internal", eyebrow: "Behind the scenes", title: "The private operating system", intro: "These tools support delivery and prove the capability, but customer records and operational controls do not belong on the public internet." },
];

const actionLabel = (tool: ToolDefinition) => tool.status === "Live" ? "Open live tool" : tool.status === "Preview" ? "Open preview" : "See the service";
---

<BaseLayout title="Tools - Dinero Hwy" description="The complete Dinero Hwy tool portfolio: live demos, client services, and the protected operating systems behind the work.">
  <section class="tools-hero container">
    <span class="eyebrow">Dinero Hwy tools</span>
    <h1>One platform. Different jobs.</h1>
    <p class="lede">Some tools are ready to use here. Some become part of a client's website. Others stay private because they contain the operating work behind the service. Every one belongs to Dinero Hwy, and every status below means exactly what it says.</p>
    <div class="legend" aria-label="Tool status meanings">
      <span><b>Live</b> working public tool</span><span><b>Preview</b> safe interactive demonstration</span>
      <span><b>Service</b> configured per client</span><span><b>Internal</b> protected operations</span>
    </div>
  </section>

  {groups.map((group) => {
    const tools = toolsByStatus(group.status);
    return (
      <section class="section container tool-group" aria-labelledby={`group-${group.status.toLowerCase()}`}>
        <div class="group-head"><span class="eyebrow">{group.eyebrow}</span><h2 id={`group-${group.status.toLowerCase()}`}>{group.title}</h2><p>{group.intro}</p></div>
        <div class="tool-grid">
          {tools.map((tool) => (
            <article class:list={["tool-card", `status-${tool.status.toLowerCase()}`]}>
              <div class="tool-top"><span class="tool-icon"><Icon name={tool.icon} size={23} /></span><span class="status">{tool.status}</span></div>
              <p class="audience">For {tool.audience}</p><h3>{tool.name}</h3><p>{tool.summary}</p>
              <p class="value"><strong>Value:</strong> {tool.value}</p>
              <div class="tool-links">
                {tool.sitePath && <a href={tool.sitePath}>{actionLabel(tool)} <Icon name="arrow-right" size={15} /></a>}
                {tool.sourceUrl && <a class="source" href={tool.sourceUrl} target="_blank" rel="noopener">Selected source <Icon name="arrow-up-right" size={14} /></a>}
                {!tool.sitePath && <span class="private">No public application route</span>}
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
  .tools-hero { padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg); }
  .tools-hero h1 { max-width: 820px; margin-top: 0.45rem; letter-spacing: 0; }
  .tools-hero .lede { max-width: 760px; color: var(--cream-muted); }
  .legend { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: var(--space-md); }
  .legend span { border: 1px solid var(--line); border-radius: 999px; padding: 0.42rem 0.7rem; color: var(--cream-muted); font-family: var(--mono); font-size: 0.72rem; }
  .legend b { color: var(--cream); }
  .tool-group { padding-top: var(--space-md); }
  .group-head { max-width: 760px; margin-bottom: var(--space-md); }
  .group-head h2 { margin: 0.35rem 0 0.55rem; letter-spacing: 0; }
  .group-head p { color: var(--cream-muted); }
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 285px), 1fr)); gap: var(--space-md); }
  .tool-card { display: grid; align-content: start; gap: 0.55rem; min-height: 100%; padding: clamp(1.1rem, 3vw, 1.55rem); border: 1px solid var(--line); border-radius: 18px; background: rgba(6, 27, 20, 0.62); box-shadow: var(--shadow-sm); }
  .tool-card.status-preview { background: linear-gradient(145deg, rgba(219, 110, 66, 0.1), transparent 42%), rgba(6, 27, 20, 0.62); }
  .tool-card.status-internal { background: rgba(6, 27, 20, 0.4); }
  .tool-top { display: flex; align-items: center; justify-content: space-between; }
  .tool-icon { color: var(--rust-light); }
  .status, .audience, .private { font-family: var(--mono); font-size: 0.7rem; font-weight: 850; letter-spacing: 0.03em; }
  .status { border: 1px solid var(--line); border-radius: 999px; padding: 0.28rem 0.55rem; color: var(--cream); }
  .status-live .status { color: #b8ffc8; border-color: rgba(94, 171, 116, 0.4); background: rgba(94, 171, 116, 0.15); }
  .status-preview .status { color: var(--rust-light); background: rgba(219, 110, 66, 0.1); }
  .audience { margin: 0.3rem 0 0; color: var(--cream-dim); text-transform: uppercase; }
  .tool-card h3 { margin: 0; font-size: var(--step-1); letter-spacing: 0; }
  .tool-card p { margin: 0; color: var(--cream-muted); }
  .tool-card .value { margin-top: 0.3rem; }
  .tool-card .value strong { color: var(--cream); }
  .tool-links { display: flex; flex-wrap: wrap; gap: 0.65rem 1rem; align-items: center; margin-top: 0.5rem; }
  .tool-links a { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--cream); font-weight: 850; }
  .tool-links .source { color: var(--cream-muted); font-size: var(--step--1); }
  .private { color: var(--cream-dim); }
</style>
