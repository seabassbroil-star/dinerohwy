---
import ProductLayout from "../layouts/ProductLayout.astro";
import DemoFrame from "../components/DemoFrame.astro";
---

<ProductLayout
  title="Showcase Sites"
  eyebrow="Websites that sell"
  icon="website"
  tagline="Fast, real websites built to book jobs and take orders — not digital brochures. Every one is a live, inspectable example."
  description="Real websites for local businesses, built on Cloudflare and demoed live."
>
  <section>
    <h2>Selected work</h2>
    <p class="lede">Curated live examples land here — each with a one-line business outcome and a link to the real, running site.</p>
    <DemoFrame title="Showcase gallery" status="coming-soon" caption="The first showcase sites are being packaged up. Want yours to be one of them?">
      <div style="min-height:220px"></div>
    </DemoFrame>
  </section>
</ProductLayout>
