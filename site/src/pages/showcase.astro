---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { toolPortfolio } from "../data/portfolio";

const featured = toolPortfolio.filter((tool) => ["markup", "menu-builder"].includes(tool.id));
const proof = toolPortfolio.filter((tool) => ["report-card", "ai-copy", "booking", "follow-up"].includes(tool.id));
---

<BaseLayout title="Showcase - Dinero Hwy" description="Try featured Dinero Hwy tools, see selected source, and understand which systems remain protected behind the service.">
  <section class="sc-hero container">
    <span class="eyebrow">Dinero Hwy showcase</span><h1>Try the experience. See the boundary.</h1>
    <p class="lede">The public demos prove what the tools can do without exposing client records, operator controls, unfinished payment paths, or private source. Selected code is public when it makes the proof stronger.</p>
  </section>

  <section class="section container featured" aria-labelledby="featured-title">
    <div class="section-head"><span class="eyebrow">Featured now</span><h2 id="featured-title">Review clearly. Preview an ordering experience.</h2></div>
    <div class="featured-grid">
      {featured.map((tool) => (
        <article class="feature-card">
          <div class="feature-icon"><Icon name={tool.icon} size={28} /></div><span class="status">{tool.status}</span>
          <h3>{tool.name}</h3><p>{tool.summary}</p><strong>{tool.value}</strong>
          {tool.sitePath && <a class="btn btn-primary" href={tool.sitePath}>Open {tool.name} <Icon name="arrow-right" size={16} /></a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section container proof" aria-labelledby="proof-title">
    <div class="section-head"><span class="eyebrow">Additional proof</span><h2 id="proof-title">Working systems already supporting the site</h2></div>
    <div class="proof-grid">
      {proof.map((tool) => (
        <article class="proof-card"><Icon name={tool.icon} size={22} /><div><span>{tool.status}</span><h3>{tool.name}</h3><p>{tool.summary}</p><div class="links">{tool.sitePath && <a href={tool.sitePath}>Open <Icon name="arrow-right" size={14} /></a>}{tool.sourceUrl && <a href={tool.sourceUrl} target="_blank" rel="noopener">Selected source <Icon name="arrow-up-right" size={14} /></a>}</div></div></article>
      ))}
    </div>
  </section>

  <section class="section container boundary">
    <Icon name="cloud" size={28} /><div><span class="eyebrow">Protected on purpose</span><h2>Internal tools are capability, not public control panels.</h2><p>Fieldwork, Research Desk, Campaign Desk, SEO Workflow Lab, the Tools Dashboard, Workspace MCP, and shared infrastructure remain local or authenticated. The site explains the customer value without publishing prospect data, client work, credentials, or operational actions.</p><a href="/tools">Review the full portfolio <Icon name="arrow-right" size={15} /></a></div>
  </section>
</BaseLayout>

<style>
  .sc-hero { padding-block: clamp(4rem, 8vw, 7rem) var(--space-lg); }
  .sc-hero h1 { max-width: 820px; margin-top: 0.45rem; letter-spacing: 0; }
  .sc-hero .lede { max-width: 720px; color: var(--cream-muted); }
  .featured, .proof { padding-top: var(--space-md); }
  .section-head { margin-bottom: var(--space-md); }
  .section-head h2 { max-width: 780px; margin-top: 0.35rem; letter-spacing: 0; }
  .featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
  .feature-card { display: grid; align-content: start; gap: 0.75rem; padding: clamp(1.3rem, 4vw, 2rem); border: 1px solid var(--line-strong); border-radius: 20px; background: linear-gradient(145deg, rgba(219, 110, 66, 0.12), transparent 48%), rgba(6, 27, 20, 0.66); }
  .feature-icon { color: var(--rust-light); }
  .status { width: fit-content; border: 1px solid var(--line); border-radius: 999px; padding: 0.28rem 0.55rem; color: var(--rust-light); font: 850 0.68rem/1.3 var(--mono); text-transform: uppercase; }
  .feature-card h3 { margin: 0; font-size: var(--step-2); letter-spacing: 0; }
  .feature-card p { margin: 0; color: var(--cream-muted); }
  .feature-card strong { color: var(--cream); }
  .feature-card .btn { width: fit-content; margin-top: 0.3rem; }
  .proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-md); }
  .proof-card { display: flex; gap: 0.8rem; padding: 1.2rem; border: 1px solid var(--line); border-radius: 17px; background: rgba(6, 27, 20, 0.54); }
  .proof-card > :global(svg) { flex: 0 0 auto; color: var(--rust-light); }
  .proof-card span { color: var(--rust-light); font: 850 0.68rem/1.3 var(--mono); text-transform: uppercase; }
  .proof-card h3 { margin: 0.2rem 0 0.4rem; font-size: var(--step-1); letter-spacing: 0; }
  .proof-card p { color: var(--cream-muted); }
  .links { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .links a, .boundary a { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 850; }
  .boundary { display: flex; gap: 1rem; align-items: flex-start; max-width: 920px; padding: clamp(1.3rem, 4vw, 2rem); border: 1px solid var(--line); border-radius: 20px; background: rgba(6, 27, 20, 0.5); }
  .boundary > :global(svg) { flex: 0 0 auto; color: var(--rust-light); }
  .boundary h2 { margin-top: 0.4rem; letter-spacing: 0; }
  .boundary p { color: var(--cream-muted); }
  @media (max-width: 760px) { .featured-grid { grid-template-columns: 1fr; } }
</style>
