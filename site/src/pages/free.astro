---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailCapture from "../components/EmailCapture.astro";
import Icon from "../components/Icon.astro";

const magnets = [
  { icon: "seo", title: "Website & Google Report Card", blurb: "Your online presence graded, plus 3 specific fixes you can make this week.", magnet: "report-card", primary: true },
  { icon: "quote", title: "Instant-Quote demo", blurb: "Play the customer: upload a photo, get a price in minutes, see the product from the inside.", magnet: "quote-demo", href: "/image-quote" },
  { icon: "ordering", title: "Online-ordering waitlist", blurb: "Print-at-store pickup ordering. Get on the list and we'll build it with you.", magnet: "ordering-waitlist" },
];
---

<BaseLayout title="Free stuff — Dinero Hwy" description="Free tools and report cards for local businesses from Dinero Hwy.">
  <section class="section container" style="max-width:820px">
    <span class="eyebrow">No cost, no pitch</span>
    <h1>Free stuff that actually helps.</h1>
    <p class="lede">Pick what's useful. Each one shows you exactly how we work — because the free thing is built with the same tools we'd build for you.</p>
  </section>

  <section class="section container">
    <div class="magnets">
      {magnets.map((m) => (
        <div class:list={["magnet card", m.primary && "is-primary"]}>
          <span class="magnet-icon"><Icon name={m.icon} size={26} /></span>
          <h2>{m.title}</h2>
          <p>{m.blurb}</p>
          {m.href
            ? <a class="btn btn-primary" href={m.href}>Try it <Icon name="arrow-right" size={16} /></a>
            : <EmailCapture variant="inline" magnet={m.magnet} source={`free:${m.magnet}`} heading="" sub="" collectBusiness={m.primary} buttonLabel="Send it to me" />}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .magnets { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .magnet { display: grid; gap: 0.6rem; align-content: start; }
  .magnet.is-primary { border-color: var(--rust); }
  .magnet-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-md); background: rgba(6,27,20,.5); border: 1px solid var(--line); color: var(--rust-light); }
  @media (max-width: 860px) { .magnets { grid-template-columns: 1fr; } }
</style>
