{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinerohwy",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // Leads database. Run `wrangler d1 create dinerohwy-leads` and paste the
  // returned database_id here AND in workers/mailer/wrangler.jsonc (same DB).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinerohwy-leads",
      "database_id": "f1de8e22-29f3-43a9-83c9-47c1f7243893"
    }
  ],

  // Workers AI — powers the AI Copy Assistant (/tools/ai-copy → /api/ai-draft).
  "ai": { "binding": "AI" },

  // KV for the AI lead-gate: OTP sessions, rate-limit counters, daily budget cap.
  "kv_namespaces": [{ "binding": "AIGATE", "id": "72fba8d2bf2c48d9ba48be410566c7bb" }],

  // Private service binding to the internal email Worker (workers/email-sender).
  // Tokenless email: the Worker holds the send_email binding Pages can't.
  "services": [
    { "binding": "EMAIL_SENDER", "service": "dinerohwy-email" },
    { "binding": "RENDER", "service": "dinerohwy-render" },
    { "binding": "BOOKING", "service": "dinerohwy-booking" }
    // MENU_IMPORT disabled: the `dinerohwy-menu-import` Worker has no source in
    // this repo and was never deployed. /api/menu-import returns a graceful 503
    // ("not configured yet") without it. Re-add once the Worker is built+deployed.
    // { "binding": "MENU_IMPORT", "service": "dinerohwy-menu-import" }
  ],

  // Image-quote photo uploads. DISABLED until R2 is enabled in the Cloudflare
  // dashboard (Account → R2 → enable). Then re-add this block + run
  // `wrangler r2 bucket create dinerohwy-uploads`. The quote demo works without
  // it (it just won't store the photo).
  // "r2_buckets": [
  //   { "binding": "UPLOADS", "bucket_name": "dinerohwy-uploads" }
  // ],

  // Email is sent via the Cloudflare Email Sending REST API (Pages Functions
  // can't use the tokenless send_email binding). MAIL_FROM's domain must be
  // onboarded: Dashboard → Email Service → Email Sending → onboard dinerohwy.com.
  "vars": {
    "SITE_URL": "https://dinerohwy.com",
    "MAIL_FROM": "Dinero Hwy <contact@dinerohwy.com>",
    // Email Sending lives in the Codingsavage account (where dinerohwy.com's
    // DNS zone is onboarded). The Pages Function calls that account's REST API.
    "CLOUDFLARE_ACCOUNT_ID": "8b01460b2f34f38394390c132bf49b99",
    "TURNSTILE_SITEKEY": "0x4AAAAAAEawGmmRMkt49lED"
  }
  // Secrets (do NOT put here) — set with `wrangler pages secret put <NAME> --project-name dinerohwy`:
  //   CLOUDFLARE_API_TOKEN   (Email Sending: Edit)
  //   TURNSTILE_SECRET       (set ✓)
  //   MENU_SESSION_SECRET     (32+ random bytes; signs anonymous menu-preview sessions)
  //   LEAD_INBOX             (already set)
}
