{
  "$schema": "../../site/node_modules/wrangler/config-schema.json",
  "name": "dinerohwy-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // Runs daily at 14:00 UTC (~9am Galveston). Sends any follow-up emails that
  // have come due and advances each lead to the next step.
  "triggers": { "crons": ["0 14 * * *"] },

  // Same leads DB as the Pages site — paste the SAME database_id used in
  // site/wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinerohwy-leads",
      "database_id": "f1de8e22-29f3-43a9-83c9-47c1f7243893"
    }
  ],

  "vars": {
    "SITE_URL": "https://dinerohwy.com",
    "MAIL_FROM": "Dinero Hwy <contact@dinerohwy.com>"
  },

  // Tokenless email via the shared internal Worker (same as the Pages site).
  "services": [{ "binding": "EMAIL_SENDER", "service": "dinerohwy-email" }],
  "observability": { "enabled": true }
  // Secret: wrangler secret put CLOUDFLARE_API_TOKEN   (run inside workers/mailer)
}
