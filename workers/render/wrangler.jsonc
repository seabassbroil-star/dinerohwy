{
  "$schema": "../../site/node_modules/wrangler/config-schema.json",
  "name": "dinerohwy-render",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // Headless Chrome (Browser Rendering) — screenshots + load metrics + HTML→PDF.
  "browser": { "binding": "BROWSER" },

  // Private: reachable only via the Pages site's RENDER service binding. No route.
  "workers_dev": false,
  "observability": { "enabled": true }

  // R2 for persisting screenshots + PDFs is added once R2 is enabled on the account:
  // "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "dinerohwy-reports" }]
}
